{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-box-preview",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "r2_buckets": [
    {
      "binding": "F1_DATA",
      "bucket_name": "f1-box-data"
    }
  ],
  "d1_databases": [
    {
      "binding": "F1_DB",
      "database_name": "f1db",
      "database_id": "50683ee9-c236-4bc5-bc11-4e8151916f54"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "785a3e7856964828a15458eefdb7ee7b"
    }
  ],
  "observability": {
    "enabled": true
  }
}
