{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-box-preview",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "r2_buckets": [
    {
      "binding": "F1_DATA",
      "bucket_name": "f1-box-data"
    }
  ],
  "observability": {
    "enabled": true
  }
}
