---
import type { SeasonIndex } from "@f1-box/contracts/season-index";

import BaseLayout from "../layouts/BaseLayout.astro";
import StatusPage from "./StatusPage.astro";

interface Props {
  year: number;
  index: SeasonIndex;
  rest: string;
  status: 404 | 503;
}
const { year, index, rest, status } = Astro.props;
const notFound = status === 404;
---

<BaseLayout
  title={notFound ? "Season not found" : "Season data unavailable"}
  year={year}
  availableYears={index.availableYears}
  rest={rest}
>
  {notFound ? (
    <StatusPage code="404" title="Season not found" message="This season is not available yet." />
  ) : (
    <StatusPage
      code="503"
      title="Season data unavailable"
      message="The season release could not be loaded. Please try again shortly."
    />
  )}
</BaseLayout>
