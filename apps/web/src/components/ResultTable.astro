---
import type { SeasonPayload } from "@f1-box/contracts/season";

type SeasonEvent = SeasonPayload["events"][number];

interface Props {
  kind: "qualifying" | "race";
  classification: SeasonEvent["qualifyingClassification"] | SeasonEvent["raceClassification"];
}

const { kind, classification } = Astro.props;
const isQualifying = kind === "qualifying";
const label = isQualifying ? "Qualifying classification" : "Race classification";
const emptyText = isQualifying
  ? "Qualifying results are not available yet."
  : "Race results are not available yet.";
type QualifyingClassification = NonNullable<SeasonEvent["qualifyingClassification"]>;
type RaceClassification = NonNullable<SeasonEvent["raceClassification"]>;
const qualifyingRows = isQualifying
  ? (classification as QualifyingClassification | null)?.rows ?? []
  : [];
const raceRows = !isQualifying
  ? (classification as RaceClassification | null)?.rows ?? []
  : [];
---

<div class="table-scroll results-scroll" tabindex="0">
  <table class="result-table" aria-label={label}>
    <thead>
      {isQualifying ? (
        <tr>
          <th scope="col">Pos</th>
          <th scope="col">Driver</th>
          <th scope="col">Constructor</th>
          <th scope="col">Q1</th>
          <th scope="col">Q2</th>
          <th scope="col">Q3</th>
        </tr>
      ) : (
        <tr>
          <th scope="col">Pos</th>
          <th scope="col">Driver</th>
          <th scope="col">Constructor</th>
          <th scope="col">Laps</th>
          <th scope="col">Time / Status</th>
          <th scope="col">Fastest lap</th>
          <th scope="col">Pts</th>
        </tr>
      )}
    </thead>
    <tbody>
      {qualifyingRows.length === 0 && raceRows.length === 0 ? (
        <tr>
          <td class="empty-cell" colspan={isQualifying ? 6 : 7}>{emptyText}</td>
        </tr>
      ) : isQualifying ? (
        qualifyingRows.map((row) => (
          <tr>
            <td class="position-cell">{row.position}</td>
            <th scope="row"><span>{row.driverName}</span><small>{row.driverCode}</small></th>
            <td>{row.constructorName}</td>
            <td>{row.q1 ?? "—"}</td>
            <td>{row.q2 ?? "—"}</td>
            <td>{row.q3 ?? "—"}</td>
          </tr>
        ))
      ) : (
        raceRows.map((row) => (
          <tr>
            <td class="position-cell">{row.position}</td>
            <th scope="row"><span>{row.driverName}</span><small>{row.driverCode}</small></th>
            <td>{row.constructorName}</td>
            <td>{row.laps}</td>
            <td>{row.time ?? row.status}</td>
            <td>{row.fastestLap ?? "—"}</td>
            <td class="points-cell">{row.points}</td>
          </tr>
        ))
      )}
    </tbody>
  </table>
</div>
