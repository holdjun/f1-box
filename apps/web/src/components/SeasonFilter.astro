---
import { summarizeYears } from "../lib/season-summary.js";

interface Props {
  years: number[];
  mode: "link" | "toggle";
  baseHref?: string;
  current?: number | null;
  label?: string;
  sticky?: boolean;
  initialSelected?: number[] | null;
  hrefFor?: (year: number) => string;
  showAll?: boolean;
}

const {
  years,
  mode,
  baseHref = "",
  current = null,
  label = "Season",
  sticky = false,
  initialSelected = null,
  hrefFor,
  showAll = mode === "link",
} = Astro.props;

interface DecadeGroup {
  label: string;
  years: number[];
}

// 年份按年代分组（1950s / 1960s / … / 2020s），年代与组内年份均降序
function groupDecades(years: number[]): DecadeGroup[] {
  const groups = new Map<number, number[]>();
  for (const year of years) {
    const decade = Math.floor(year / 10) * 10;
    const list = groups.get(decade) ?? [];
    list.push(year);
    groups.set(decade, list);
  }
  return [...groups.entries()]
    .sort((a, b) => b[0] - a[0])
    .map(([decade, list]) => ({
      label: `${decade}s`,
      years: list.sort((a, b) => b - a),
    }));
}

const decades = groupDecades(years);
const isSelected = (year: number) =>
  mode === "link" ? current === year : initialSelected?.includes(year) ?? false;
const summary =
  mode === "link"
    ? current === null
      ? "All seasons"
      : String(current)
    : summarizeYears(initialSelected ?? []);
const count =
  initialSelected && initialSelected.length > 0
    ? `${initialSelected.length} selected`
    : "All seasons";

// preflight 把 button 光标重置为 default，交互按钮需补 cursor-pointer
const itemClasses =
  "shrink-0 rounded-sm px-2.5 py-1.5 text-[0.78rem] tabular-nums text-ink-muted transition-colors";
const itemHover = "hover:bg-surface-overlay hover:text-ink";
---

<div
  class:list={["season-filter relative mt-4 mb-5", { "season-filter--sticky": sticky }]}
  data-season-filter
  data-mode={mode}
  data-initial-selected={initialSelected?.join(",") ?? ""}
>
  <button
    type="button"
    class="season-filter__trigger inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-md border border-line bg-surface-raised px-4 text-[0.72rem] font-semibold tracking-[0.09em] uppercase text-ink-strong transition-colors hover:border-ink-muted hover:text-ink"
    aria-expanded="false"
    aria-label={label}
    data-season-filter-trigger
  >
    <span class="season-filter__summary" data-season-filter-summary
      >{summary}</span
    >
    <svg
      class="season-filter__caret w-2.8 h-auto fill-none stroke-current stroke-[1.6] transition-transform duration-200"
      viewBox="0 0 12 8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M1 1l5 5 5-5"></path>
    </svg>
  </button>

  <div
    class="season-filter__panel absolute left-0 top-[calc(100%+0.4rem)] z-20 w-[min(92vw,26rem)] min-w-64 overflow-y-auto rounded-md border border-line bg-surface-raised p-3 shadow-panel"
    data-season-filter-panel
    hidden
  >
    {mode === "link" && !showAll ? null : (
      <div class="season-filter__actions mb-3 flex items-center gap-2.5 border-b border-line pb-3">
        {mode === "link" ? (
          <a
            class:list={[
              "season-filter__action",
              itemClasses,
              itemHover,
              "text-ink-strong",
              { "is-active": current === null },
            ]}
            href={baseHref}
          >All seasons</a>
        ) : (
          <button
            type="button"
            class:list={[
              "season-filter__action",
              itemClasses,
              itemHover,
              "cursor-pointer text-ink-strong",
            ]}
            data-season-filter-all
          >All</button>
        )}
        {mode === "toggle" ? (
          <span
            class="season-filter__count ml-auto text-[0.7rem] text-ink-muted"
            data-season-filter-count
            >{count}</span
          >
        ) : null}
      </div>
    )}

    <div class="season-filter__groups">
      {decades.map((decade) => (
        <div class="season-filter__group grid grid-cols-[3.5rem_1fr] items-baseline gap-2 py-1.5">
          {mode === "toggle" ? (
            <button
              type="button"
              class:list={["season-filter__decade", itemClasses, itemHover, "cursor-pointer"]}
              data-season-decade={decade.label}
            >{decade.label}</button>
          ) : (
            <span class:list={["season-filter__decade", itemClasses]}
              >{decade.label}</span
            >
          )}
          <div class="season-filter__years flex flex-wrap gap-1">
            {decade.years.map((year) =>
              mode === "link" ? (
                <a
                  class:list={[
                    "season-filter__year",
                    itemClasses,
                    itemHover,
                    { "is-active": current === year },
                  ]}
                  href={hrefFor ? hrefFor(year) : `${baseHref}?year=${year}`}
                  data-season-year={year}
                >{year}</a>
              ) : (
                <button
                  type="button"
                  class:list={[
                    "season-filter__year",
                    itemClasses,
                    itemHover,
                    "cursor-pointer",
                    { "is-active": isSelected(year) },
                  ]}
                  data-season-year={year}
                  aria-pressed={isSelected(year)}
                >{year}</button>
              ),
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  /* is-active 由 client.ts 切换，无法以纯工具类表达 */
  .season-filter :is(.is-active, [aria-pressed="true"]) {
    background-color: var(--accent);
    color: var(--on-accent);
  }
  /* 顶部导航 sticky（min-h-16 / lg:min-h-18），粘顶位置需避开导航 */
  .season-filter--sticky { position: sticky; z-index: 5; top: 4.5rem; }
  @media (min-width: 61.25rem) { .season-filter--sticky { top: 5rem; } }
  /* --up 与 caret 状态由 client.ts / aria-expanded 驱动 */
  .season-filter__panel--up { top: auto; bottom: calc(100% + 0.4rem); }
  .season-filter__trigger[aria-expanded="true"] .season-filter__caret { transform: rotate(180deg); }
</style>
