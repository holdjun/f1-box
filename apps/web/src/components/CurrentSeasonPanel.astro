---
import type { CurrentSeason } from "../lib/team-repository.js";

interface Props {
  season: CurrentSeason;
}
const { season } = Astro.props;
---

<div class="info-panel" aria-label={`${season.year} season`}>
  <h2>{season.year} Season</h2>
  <div class="season-head">
    <div>
      <span>Season Position</span>
      <strong>{season.position ?? "—"}</strong>
    </div>
    <div>
      <span>Season Points</span>
      <strong>{season.points ?? "—"}</strong>
    </div>
  </div>
  <h3>Grand Prix</h3>
  <dl>
    <div><dt>Races</dt><dd>{season.grandPrix.races}</dd></div>
    <div><dt>Points</dt><dd>{season.grandPrix.points}</dd></div>
    <div><dt>Wins</dt><dd>{season.grandPrix.wins}</dd></div>
    <div><dt>Podiums</dt><dd>{season.grandPrix.podiums}</dd></div>
    <div><dt>Poles</dt><dd>{season.grandPrix.poles}</dd></div>
    <div><dt>Top 10s</dt><dd>{season.grandPrix.top10s}</dd></div>
    <div><dt>Fastest Laps</dt><dd>{season.grandPrix.fastestLaps}</dd></div>
    <div><dt>DNFs</dt><dd>{season.grandPrix.dnfs}</dd></div>
  </dl>
  {season.sprint.races > 0 ? (
    <>
      <h3>Sprint</h3>
      <dl>
        <div><dt>Races</dt><dd>{season.sprint.races}</dd></div>
        <div><dt>Points</dt><dd>{season.sprint.points}</dd></div>
        <div><dt>Wins</dt><dd>{season.sprint.wins}</dd></div>
        <div><dt>Podiums</dt><dd>{season.sprint.podiums}</dd></div>
        <div><dt>Poles</dt><dd>{season.sprint.poles}</dd></div>
        <div><dt>Top 10s</dt><dd>{season.sprint.top10s}</dd></div>
      </dl>
    </>
  ) : null}
</div>

<style>
  .info-panel {
    flex: 1 1 18rem;
    padding: 1.1rem 1.35rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--ink-soft);
  }
  .info-panel h2 {
    margin: 0 0 0.9rem;
    font-family: var(--display);
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .info-panel h2::before {
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    margin-right: 0.5rem;
    background: var(--coral);
    content: "";
  }
  .info-panel h3 {
    margin: 1rem 0 0.45rem;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .season-head {
    display: flex;
    gap: 2.5rem;
  }
  .season-head span {
    display: block;
    font-size: 0.68rem;
    color: var(--muted);
  }
  .season-head strong {
    font-family: var(--display);
    font-size: 1.9rem;
    line-height: 1.1;
  }
  .info-panel dl {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 0.7rem 1rem;
    margin: 0;
  }
  .info-panel dt {
    font-size: 0.68rem;
    color: var(--muted);
  }
  .info-panel dd {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }
</style>
