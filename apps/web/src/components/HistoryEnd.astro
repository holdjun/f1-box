---
interface Props {
  summary: string;
  backHref: string;
  backLabel: string;
}
const { summary, backHref, backLabel } = Astro.props;
---

<footer class="mt-14 grid justify-items-center gap-2.5 text-center before:block before:w-36 before:border-t before:border-line before:content-['']">
  <p class="history-end__summary text-[0.72rem] font-bold uppercase tracking-[0.1em] text-ink-muted">
    {summary}
  </p>
  <a
    class="history-end__back border-b border-ink-muted pb-0.5 text-[0.72rem] font-bold uppercase tracking-[0.08em] transition-colors hover:border-highlight hover:text-highlight"
    href={backHref}
  >{backLabel}</a>
</footer>
