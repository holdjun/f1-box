---
import type { SeasonPayload } from "@f1-box/contracts/season";

import FreshnessBadge from "./FreshnessBadge.astro";
import { formatUtcDateTime } from "../lib/time.js";

type SeasonEvent = SeasonPayload["events"][number];

interface Props {
  event: SeasonEvent;
  season: number;
  freshness: SeasonPayload["freshness"];
}

const { event, season, freshness } = Astro.props;
const round = String(event.round).padStart(2, "0");
const targetTime = Date.parse(event.startsAt);
const isFuture = targetTime > Date.now();
const sessions = event.sessions.filter((session) =>
  session.key === "qualifying" || session.key === "race"
);
---

<section class="next-race-hero page-shell" aria-labelledby="next-race-title">
  <div class="next-race-hero__grid" aria-hidden="true"></div>
  <div class="next-race-hero__meta hero-enter hero-enter--1">
    <p>{season} SEASON / ROUND {round}</p>
    <span class="status-label status-label--accent">NEXT RACE</span>
  </div>

  <div class="next-race-hero__title hero-enter hero-enter--2">
    <p class="giant-round" aria-hidden="true">{round}</p>
    <h1 id="next-race-title">{event.raceName}</h1>
    <p class="location">{event.circuit.locality}, {event.circuit.country}</p>
    <p class="circuit">{event.circuit.name}</p>
  </div>

  <div class="next-race-hero__details hero-enter hero-enter--3">
    <div class="countdown-block" data-countdown data-target={event.startsAt}>
      <div class="countdown-block__label">
        <p>RACE STARTS IN</p>
        <FreshnessBadge freshness={freshness} />
      </div>
      <div class="countdown" hidden={!isFuture} aria-live="off">
        {[
          ["days", "Days"],
          ["hours", "Hours"],
          ["minutes", "Mins"],
          ["seconds", "Secs"],
        ].map(([unit, label]) => (
          <span>
            <strong data-countdown-unit={unit}>00</strong>
            <small>{label}</small>
          </span>
        ))}
      </div>
      <p class="countdown-passed" data-countdown-passed hidden={isFuture}>
        Schedule time has passed
      </p>
    </div>

    <div class="session-list" aria-label="Key sessions">
      {sessions.map((session) => (
        <div class="session-list__item">
          <p>{session.name}</p>
          <time datetime={session.startsAt}>{formatUtcDateTime(session.startsAt)}</time>
          <span data-local-time data-timestamp={session.startsAt} hidden></span>
        </div>
      ))}
    </div>
  </div>

  <div class="next-race-hero__actions hero-enter hero-enter--4">
    <a class="button button--primary" href={`/seasons/${season}/races/${event.round}-${event.slug}`}>
      View race
      <svg viewBox="0 0 28 16" aria-hidden="true"><path d="M1 8h24M18 1l7 7-7 7" /></svg>
    </a>
    <a class="button button--text" href={`/seasons/${season}`}>
      Explore {season} season
    </a>
  </div>
</section>
