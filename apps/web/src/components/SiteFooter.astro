---
interface Props {
  season?: number;
}

const { season } = Astro.props;
---

<footer class="border-t border-line bg-surface-sunken py-12">
  <div class="shell text-[0.76rem] text-ink-strong">
    {season !== undefined ? (
      <p class="font-display text-2xl text-ink uppercase">{season} season data</p>
    ) : null}
  </div>
</footer>
