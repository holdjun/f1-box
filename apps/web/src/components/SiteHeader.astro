---
interface Props {
  active?: "racing" | "results" | "circuits" | "drivers" | "teams";
  year?: number;
}

const { active = "racing", year } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner page-shell">
    <a class="wordmark" href="/" aria-label="F1 Box home">
      <span>F1</span> Box
    </a>
    <nav aria-label="Primary navigation">
      <a
        href={year ? `/racing/${year}` : "/"}
        aria-current={active === "racing" ? "page" : undefined}
      >Racing</a>
      <a
        href={year ? `/results/${year}/races` : "/results"}
        aria-current={active === "results" ? "page" : undefined}
      >Results</a>
      <a
        href="/circuits"
        aria-current={active === "circuits" ? "page" : undefined}
      >Circuits</a>
      <a
        href="/drivers"
        aria-current={active === "drivers" ? "page" : undefined}
      >Drivers</a>
      <a
        href="/teams"
        aria-current={active === "teams" ? "page" : undefined}
      >Teams</a>
    </nav>
  </div>
</header>
