---
import YearSelector from "./YearSelector.astro";

interface Props {
  active?: "racing" | "results" | "drivers" | "teams";
  year?: number;
  availableYears?: number[];
  rest?: string;
  yearHref?: (year: number) => string;
}

const { active = "racing", year, availableYears, rest = "", yearHref } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner page-shell">
    <a class="wordmark" href="/" aria-label="F1 Box home">
      <span>F1</span> Box
    </a>
    <nav aria-label="Primary navigation">
      <a
        href={year ? `/${year}/racing` : "/"}
        aria-current={active === "racing" ? "page" : undefined}
      >Racing</a>
      <a
        href={year ? `/results/${year}/races` : "/results"}
        aria-current={active === "results" ? "page" : undefined}
      >Results</a>
      <a
        href="/drivers"
        aria-current={active === "drivers" ? "page" : undefined}
      >Drivers</a>
      <a
        href="/teams"
        aria-current={active === "teams" ? "page" : undefined}
      >Teams</a>
    </nav>
    {year !== undefined && availableYears !== undefined ? (
      <YearSelector current={year} available={availableYears} rest={rest} hrefFor={yearHref} />
    ) : null}
  </div>
</header>
