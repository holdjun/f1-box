    @apply max-w-[86%] rounded-md px-3 py-2.5 leading-[1.55] whitespace-pre-wrap wrap-anywhere;
  }
  .ask__bubble--user {
    @apply self-end bg-accent text-on-accent;
  }
  .ask__bubble--assistant {
    @apply self-start border border-line bg-surface text-ink;
  }
