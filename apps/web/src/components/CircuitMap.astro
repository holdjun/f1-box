---
import rawMaps from "../data/circuit-maps.json";

interface CircuitMapData {
  circuitId: string;
  source: string;
  sectors: [number, number][][];
  corners: { x: number; y: number; n: number; letter: string }[];
  drs: [number, number][];
}

interface Props {
  layoutId: string | null;
  // 无注解数据时回落 f1db 轮廓 SVG
  fallbackSrc?: string | null;
  alt: string;
}

const { layoutId, fallbackSrc = null, alt } = Astro.props;
const map = layoutId
  ? (rawMaps as unknown as Record<string, CircuitMapData>)[layoutId]
  : undefined;

// F1 官方 sector 配色（数据语义色，不参与主题翻转）
const SECTOR_COLORS = ["#ec008c", "#ffd400", "#00a3e0"];
const pointsAttr = (pts: [number, number][]) =>
  pts.map(([x, y]) => `${x},${y}`).join(" ");

// 源坐标基于 500×500 正方形画布，而赛道多为横向，上下留白接近图形本身高度。
// 按实际点集裁出 viewBox：padding 要包住外描边（stroke-width 13 的一半）与弯角圆标（r=9.5）
const PADDING = 18;
const viewBox = ((): string => {
  const xs: number[] = [];
  const ys: number[] = [];
  for (const pts of map?.sectors ?? []) {
    for (const [x, y] of pts) {
      xs.push(x);
      ys.push(y);
    }
  }
  for (const corner of map?.corners ?? []) {
    xs.push(corner.x);
    ys.push(corner.y);
  }
  if (xs.length === 0) return "0 0 500 500";
  const minX = Math.min(...xs) - PADDING;
  const minY = Math.min(...ys) - PADDING;
  return `${minX} ${minY} ${Math.max(...xs) + PADDING - minX} ${Math.max(...ys) + PADDING - minY}`;
})();
---

{map ? (
  <>
  <svg class="circuit-map text-ink-strong" viewBox={viewBox} role="img" aria-label={alt}>
    {map.sectors.map((pts) => (
      <polyline class="circuit-map__outline" points={pointsAttr(pts)} />
    ))}
    {map.sectors.map((pts) => (
      <polyline class="circuit-map__track" points={pointsAttr(pts)} />
    ))}
    {map.sectors.map((pts, i) => (
      <polyline
        class="circuit-map__sector"
        stroke={SECTOR_COLORS[i]}
        points={pointsAttr(pts)}
      />
    ))}
    {map.drs.map(([x, y]) => (
      <circle class="circuit-map__drs" cx={x} cy={y} r="5" />
    ))}
    {map.corners.map((corner) => (
      <g class="circuit-map__corner" transform={`translate(${corner.x} ${corner.y})`}>
        <circle r="9.5" />
        <text>{corner.n}{corner.letter}</text>
      </g>
    ))}
  </svg>
    <div class="circuit-map__legend" aria-hidden="true">
      <span class="legend"><i class="legend-line legend-line--s1"></i>Sector 1</span>
      <span class="legend"><i class="legend-line legend-line--s2"></i>Sector 2</span>
      <span class="legend"><i class="legend-line legend-line--s3"></i>Sector 3</span>
      <span class="legend"><i class="legend-corner">1</i>Corner</span>
      {map.drs.length > 0 ? (
        <span class="legend"><i class="legend-drs"></i>DRS</span>
      ) : null}
    </div>
  </>
  ) : fallbackSrc ? (
  /* f1db 轮廓 SVG 描边固定白色，亮色主题反相成深色 */
  <img class="circuit-map light:invert" src={fallbackSrc} alt={alt} />
) : null}

<style>
  /* SVG 结构必需：描边走 currentColor，由使用方（text-ink-strong）决定深浅，双主题自适应 */
  .circuit-map {
    display: block;
    width: 100%;
    height: auto;
  }
  .circuit-map__outline,
  .circuit-map__track,
  .circuit-map__sector {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .circuit-map__outline { stroke: currentColor; stroke-width: 13; }
  .circuit-map__track { stroke: var(--surface); stroke-width: 9; }
  .circuit-map__sector { stroke-width: 3.5; }
  .circuit-map__drs { fill: var(--highlight); }
  .circuit-map__corner circle { fill: currentColor; }
  .circuit-map__corner text {
    fill: var(--surface);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: central;
  }

  /* 图例（仅注解地图）：Sector 三色为数据语义色，与图上 sector 着色一致 */
  .circuit-map__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    margin-top: 0.75rem;
    font-size: 0.72rem;
    color: var(--ink-muted);
  }
  .circuit-map__legend .legend {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .legend-line {
    width: 0.9rem;
    height: 3px;
    border-radius: 2px;
  }
  .legend-line--s1 { background: #ec008c; }
  .legend-line--s2 { background: #ffd400; }
  .legend-line--s3 { background: #00a3e0; }
  .legend-corner {
    display: grid;
    place-items: center;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: currentColor;
    color: var(--surface);
    font-family: var(--font-sans);
    font-size: 0.5rem;
    font-weight: 700;
    font-style: normal;
  }
  .legend-drs {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--highlight);
  }
</style>
