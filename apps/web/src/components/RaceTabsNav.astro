---
import type { RaceTabKey } from "../lib/race-results-repository.js";
import { RACE_TAB_LABELS } from "../lib/routing.js";

interface Props {
  year: number;
  slug: string;
  active: RaceTabKey;
  visibleTabs: RaceTabKey[];
}
const { year, slug, active, visibleTabs } = Astro.props;
// overflow-x-auto 容器内的标签禁止收缩，窄屏才能横向滚动而非折行
const itemClasses =
  "inline-flex min-h-11 shrink-0 items-center whitespace-nowrap px-4 text-[0.72rem] font-semibold tracking-[0.1em] uppercase text-ink-muted transition-colors hover:text-ink aria-[current=page]:text-ink aria-[current=page]:[box-shadow:inset_0_-2px_var(--accent)]";
---

<nav data-tab-anchor class="mt-4 flex gap-1 overflow-x-auto border-b border-line" aria-label="Race result types">
  {visibleTabs.map((key) => (
    <a
      href={`/results/${year}/races/${slug}/${key}`}
      class={itemClasses}
      aria-current={key === active ? "page" : undefined}
    >{RACE_TAB_LABELS[key]}</a>
  ))}
</nav>
