---
import type { RaceSummary } from "../lib/race-results-repository.js";
import { formatUtcDateTime } from "../lib/time.js";

interface Props {
  race: RaceSummary;
  href: string;
  status: "complete" | "next" | "upcoming";
}

const { race, href, status } = Astro.props;
const round = String(race.round).padStart(2, "0");
const startsAt = `${race.date}T${race.time ?? "00:00"}:00Z`;
// 部分赛道与地点字段同值（Suzuka/Suzuka），去重后只展示一次
const placeLine =
  race.circuitName && race.circuitName !== race.circuitPlace
    ? `${race.circuitPlace} · ${race.circuitName}`
    : race.circuitPlace;
const labels = { complete: "COMPLETE", next: "NEXT", upcoming: "UPCOMING" };
---

<article class="race-card min-w-0">
  <a
    href={href}
    aria-label={`Round ${round}: ${race.raceName}, ${race.countryName}`}
    class:list={[
      "group relative flex h-full flex-col overflow-hidden rounded-md border bg-surface-raised p-5 transition-[background-color,transform,border-color] duration-200 hover:z-1 hover:-translate-y-1 hover:bg-surface-overlay focus-visible:z-1",
      // border-line 与 border-accent 互斥：并列时编译顺序会让 border-line 覆盖 accent；
      // 同理 light:shadow-panel 会盖掉 next 的 inset 顶栏，只给非 next 卡
      status === "next"
        ? "border-accent [box-shadow:inset_0_3px_var(--accent)]"
        : "border-line light:shadow-panel",
    ]}
  >
    <div class="flex items-center gap-2.5">
      <span
        class="font-display text-[2.6rem] leading-none font-semibold text-transparent [-webkit-text-stroke:1px_var(--ink-muted)]"
        aria-hidden="true">{round}</span>
      <img
        src={`/vendor/country-flags/${race.alpha2Code.toLowerCase()}.svg`}
        alt=""
        class="vendor-cell__flag"
        loading="lazy"
      />
      <span class:list={["status-label ml-auto", status === "next" && "status-label--accent"]}>
        {labels[status]}
      </span>
    </div>
    <div class="mt-4 pr-8">
      <h3 class="font-display text-[1.9rem] leading-[1.02] font-semibold uppercase">{race.raceName}</h3>
      <time class="mt-2.5 block text-[0.76rem] text-ink-strong" datetime={startsAt}>
        {formatUtcDateTime(startsAt)}
      </time>
      <p class="mt-1 text-[0.78rem] text-ink-muted">{placeLine}</p>
      {status === "complete" && (
        <dl class="mt-5 grid grid-cols-2 gap-4 border-t border-line pt-4">
          <div>
            <dt class="text-[0.65rem] tracking-[0.08em] uppercase text-ink-muted">Pole</dt>
            <dd class="mt-1 text-[0.78rem]">{race.poleName ?? "—"}</dd>
          </div>
          <div>
            <dt class="text-[0.65rem] tracking-[0.08em] uppercase text-ink-muted">Winner</dt>
            <dd class="mt-1 text-[0.78rem]">{race.winnerName}</dd>
          </div>
        </dl>
      )}
    </div>
    <svg
      class="absolute right-5 bottom-5 w-7 text-ink-muted transition-colors group-hover:text-accent"
      viewBox="0 0 28 16"
      fill="none"
      stroke="currentColor"
      stroke-linecap="square"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M1 8h24M18 1l7 7-7 7" />
    </svg>
  </a>
</article>
