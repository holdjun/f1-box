---
import type { WeekendNode } from "../lib/race-weekend.js";
import { formatWeekdayTime } from "../lib/time.js";

interface Props {
  nodes: WeekendNode[];
  timeZone: string | null;
  year: number;
  slug: string;
}
const { nodes, timeZone, year, slug } = Astro.props;
// 无时区映射（f1db 新增赛道未补进 circuit-timezones.json）时赛道行退化为 UTC，
// 标签必须跟着改：把 UTC 时刻标成赛道时间比不显示更糟
const trackLabel = timeZone === null ? "UTC" : "Track time";
// My time 只能在客户端算：SSR 无从得知浏览器时区，无 JS 时整行不出现，
// 绝不拿 UTC 时刻冒充本地时间
---

<section class="weekend-progress shell mt-10">
  <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-line pb-3">
    <h2 class="text-[0.72rem] font-semibold tracking-[0.09em] uppercase text-ink-muted">
      Weekend schedule
    </h2>
    <a
      class="text-[0.72rem] font-semibold tracking-[0.09em] uppercase text-ink-muted underline decoration-line underline-offset-4 transition-colors hover:text-accent"
      href={`/api/calendar.ics?year=${year}&race=${slug}`}
      download={`f1-${slug}-${year}.ics`}>+ Add to calendar</a>
  </div>
  <ol class="grid list-none grid-cols-1 p-0 sm:grid-cols-2 lg:grid-cols-5">
    {nodes.map((node) => (
      <li class="weekend-progress__node flex items-baseline justify-between gap-4 border-b border-line py-3 lg:block lg:border-r lg:py-4 lg:pr-4 lg:last:border-r-0">
        <h3 class="text-[0.95rem] font-semibold tracking-[0.04em] uppercase">{node.label}</h3>
        <div class="grid shrink-0 grid-cols-[auto_1fr] gap-x-3 text-right text-[0.76rem] lg:mt-2 lg:gap-y-1 lg:text-left">
          <span class="text-ink-muted" data-my-row hidden>My time</span>
          <time class="tabular-nums text-ink-strong" datetime={node.startsAtUtc} data-my-time hidden></time>
          <span class="text-ink-muted">{trackLabel}</span>
          <time
            class="tabular-nums text-ink-muted"
            datetime={node.startsAtUtc}
            data-track-time>{formatWeekdayTime(node.startsAtUtc, timeZone ?? "UTC")}</time>
        </div>
      </li>
    ))}
  </ol>
</section>

<script>
  // 一次性客户端变换（非 island）：补出浏览器时区那一行
  import { formatWeekdayTime } from "../lib/time.js";

  const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
  for (const el of document.querySelectorAll<HTMLTimeElement>("[data-my-time]")) {
    el.textContent = formatWeekdayTime(el.dateTime, zone);
    el.hidden = false;
  }
  for (const el of document.querySelectorAll<HTMLElement>("[data-my-row]")) {
    el.hidden = false;
  }
</script>
