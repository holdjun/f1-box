---
import type { WeekendNode } from "../lib/race-weekend.js";
import { formatWeekdayDate, formatWeekdayTime, hasPublishedStart } from "../lib/time.js";

interface Props {
  nodes: WeekendNode[];
  timeZone: string | null;
  year: number;
  slug: string;
  raceName: string;
}
const { nodes, timeZone, year, slug, raceName } = Astro.props;
// 无时区映射（f1db 新增赛道未补进 circuit-timezones.json）时赛道行退化为 UTC，
// 标签必须跟着改：把 UTC 时刻标成赛道时间比不显示更糟
const trackLabel = timeZone === null ? "UTC" : "Track";
// My time 只能在客户端算（见 scripts/client.ts）：SSR 无从得知浏览器时区，
// 无 JS 时整行不出现，绝不拿 UTC 时刻冒充本地时间
// 没有任何已公布发车时刻时（历史赛季的常态）ics 里一个事件都不会有，
// calendar.ics 直接 404；入口随之不出，不给必然失败的按钮
const hasCalendar = nodes.some((node) => hasPublishedStart(node.startsAtUtc));
// 任一节点有天气时，每个节点都占一行天气位（无天气的节点渲染 &nbsp; 占位，
// 空元素撑不起行高），避免同一页里格子参差；完全无天气时不占用布局高度。
const raceIcs = `${Astro.url.origin}/api/calendar.ics?year=${year}&race=${slug}`;
const seasonIcs = `${Astro.url.origin}/api/calendar.ics?year=${year}`;
// 整体替换 scheme（含 https 的 s）：生产 https 下若只替换 http 前缀会产出非法的 webcals://
const webcal = (href: string) => href.replace(/^https?:\/\//, "webcal://");
const linkClass =
  "py-0.5 text-[0.82rem] text-ink-muted underline decoration-line underline-offset-4 transition-colors hover:text-accent";

// 天气图标：按 weatherCode 粗分，回退到气温行。图标只是视觉提示，不承担语义。
// trackside（F1 计时流）用 trackTempC 当第三项，forecast（Open-Meteo）用降水概率。
function weatherIcon(code: string | null): string {
  if (code === null) return "☁";
  const c = code.toLowerCase();
  if (c.includes("thunder")) return "⛈";
  if (c.includes("rain") || c.includes("drizzle")) return "🌦";
  if (c.includes("snow")) return "🌨";
  if (c.includes("fog") || c.includes("mist")) return "🌫";
  if (c.includes("clear") || c.includes("sun")) return "☀";
  if (c.includes("cloud")) return "☁";
  return "☁";
}

// 天气行第三项：trackTempC（trackside）> 降水概率（forecast）> 无。
// 单位后缀不能省：24° 与 41° track 并列时，没后缀就是两个温度堆在一起。
// 温度缺失时不渲染那一项，不能拿 0° 顶替——编造的数值比空白更糟；
// 两项都没有就返回 null，这一格当作没有天气处理。
function weatherDisplay(weather: NonNullable<WeekendNode["weather"]>): {
  icon: string;
  temp: string | null;
  third: string | null;
} | null {
  const temp = weather.tempC === null ? null : `${Math.round(weather.tempC)}°`;
  const third =
    weather.trackTempC !== null
      ? `${Math.round(weather.trackTempC)}° track`
      : weather.prob !== null
        ? `${Math.round(weather.prob)}% rain`
        : null;
  if (temp === null && third === null) return null;
  return { icon: weatherIcon(weather.weatherCode), temp, third };
}

// 预先算好：模板里每个节点只取一次，hasWeather 也按真实可渲染结果判定，
// 而不是只看有没有 weather 字段。
const rows = nodes.map((node) => ({
  node,
  weather: node.weather ? weatherDisplay(node.weather) : null,
  source: node.weather?.source ?? null,
}));
const hasWeather = rows.some((row) => row.weather !== null);
// 署名只在真的渲染了 Open-Meteo 数据时出现（许可要求），
// 有 forecast 行但渲染不出任何值时不算使用。
const hasForecast = rows.some(
  (row) => row.weather !== null && row.source === "forecast",
);
---

<section class="weekend-progress shell mt-12">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-line pb-3">
    <h2 class="status-label text-[0.82rem]">Weekend schedule</h2>
    {hasCalendar && (
      <>
        <button type="button" class="button button--text calendar-entry-trigger" data-calendar-trigger hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><rect x="3.5" y="5" width="17" height="15.5" /><path d="M3.5 9.5h17M8 3v4M16 3v4" /></svg
          >
          Add to calendar
        </button>
        <p class="calendar-entry-fallback" data-calendar-fallback>
          <a class={linkClass} href={raceIcs} data-calendar-race download={`f1-${slug}-${year}.ics`}
            >This race .ics</a>
          <span aria-hidden="true"> · </span>
          <a class={linkClass} href={seasonIcs} download={`f1-${year}.ics`}>Full season .ics</a>
        </p>
      </>
    )}
  </div>
  <ol class="grid list-none grid-cols-1 p-0 sm:grid-cols-2 lg:grid-cols-5">
    {rows.map(({ node, weather }) => (
      <li class="weekend-progress__node flex items-center justify-between gap-4 border-b border-line px-1 py-4 lg:block lg:border-r lg:px-6 lg:py-7 lg:text-center lg:first:pl-0 lg:last:border-r-0 lg:last:pr-0">
        <h3 class="flex items-center gap-2 text-[0.8rem] font-semibold tracking-[0.08em] uppercase text-ink-muted lg:justify-center">
          {node.key === "race" || node.key === "sprint" ? (
            <span class="weekend-progress__flag" aria-hidden="true"></span>
          ) : null}
          {node.label}
        </h3>
        <div class="shrink-0 text-right lg:mt-3 lg:text-center">
          {hasPublishedStart(node.startsAtUtc) ? (
            <>
              <p class="text-[0.85rem] tabular-nums text-ink-strong" hidden>
                <span class="mr-1.5 inline-block min-w-[2.4rem] text-right text-[0.68rem] tracking-[0.08em] uppercase text-ink-muted">My</span>
                <time datetime={node.startsAtUtc} data-my-time></time>
              </p>
              <p class="text-[0.85rem] tabular-nums text-ink-muted">
                <span class="mr-1.5 inline-block min-w-[2.4rem] text-right text-[0.68rem] tracking-[0.08em] uppercase">{trackLabel}</span>
                <time datetime={node.startsAtUtc} data-track-time>{formatWeekdayTime(node.startsAtUtc, timeZone ?? "UTC")}</time>
              </p>
            </>
          ) : (
            <p class="text-[0.85rem] tabular-nums text-ink-muted">
              <time datetime={node.startsAtUtc.slice(0, 10)} data-session-date>{formatWeekdayDate(node.startsAtUtc)}</time>
            </p>
          )}
        </div>
        {hasWeather ? (
          <p class="mt-1 text-[0.8rem] tabular-nums text-ink-muted">
            {weather ? (
              <>
                <span aria-hidden="true">{weather.icon}</span>
                {weather.temp ? <span class="ml-1.5">{weather.temp}</span> : null}
                {weather.third ? (
                  <span class="ml-1.5 text-ink-strong">{weather.third}</span>
                ) : null}
              </>
            ) : (
              <span aria-hidden="true">&nbsp;</span>
            )}
          </p>
        ) : null}
      </li>
    ))}
  </ol>

  {hasForecast ? (
    <p class="mt-2 text-[0.7rem] text-ink-muted">
      Forecast data by <a class="underline decoration-line underline-offset-2 hover:text-accent" href="https://open-meteo.com/" rel="noreferrer nofollow" target="_blank">Open-Meteo</a>
    </p>
  ) : null}

  {hasCalendar && (
  <dialog class="calendar-dialog" data-calendar-dialog aria-labelledby="weekend-calendar-title">
    <div class="flex items-start justify-between gap-4">
      <h2 id="weekend-calendar-title" class="font-display text-[1.15rem] leading-tight font-semibold uppercase">
        Add to calendar
      </h2>
      <button type="button" class="calendar-dialog__close" data-calendar-close aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <div class="mt-5 grid gap-5">
      <div>
        <p class="text-[0.9rem] font-semibold text-ink-strong">{raceName} weekend</p>
        <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
          <a class={linkClass} href={webcal(raceIcs)}>Subscribe</a>
          <a class={linkClass} href={raceIcs} download={`f1-${slug}-${year}.ics`}>Download .ics</a>
          <button type="button" class:list={[linkClass, "cursor-pointer"]} data-calendar-copy={raceIcs}
            >Copy URL</button>
        </p>
      </div>
      <div class="border-t border-line pt-5">
        <p class="text-[0.9rem] font-semibold text-ink-strong">Full {year} season</p>
        <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
          <a class={linkClass} href={webcal(seasonIcs)}>Subscribe</a>
          <a class={linkClass} href={seasonIcs} download={`f1-${year}.ics`}>Download .ics</a>
          <button type="button" class:list={[linkClass, "cursor-pointer"]} data-calendar-copy={seasonIcs}
            >Copy URL</button>
        </p>
      </div>
    </div>
  </dialog>
  )}
</section>

<style>
  /* 赛格旗方格：正赛与 Sprint 两格的身份标记，纯 CSS 免掉一张图 */
  .weekend-progress__flag {
    width: 0.6rem;
    height: 0.6rem;
    background:
      conic-gradient(var(--ink-strong) 0 25%, transparent 0 50%, var(--ink-strong) 0 75%, transparent 0)
      0 0 / 50% 50%;
    outline: 1px solid var(--line);
  }
</style>
