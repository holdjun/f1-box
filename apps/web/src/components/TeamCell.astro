---
import { logoSrcFor, logoVariantFor, vendorIndexes } from "../lib/vendor.js";

interface Props {
  constructorId: string;
  constructorName: string;
}
const { constructorId, constructorName } = Astro.props;
const logo = logoSrcFor(vendorIndexes, constructorId);
---

<a
  class:list={[
    "vendor-cell",
    // 无 logo 的老赛季车队窄屏不能收成纯 logo，否则单元格一片空白
    logo && "vendor-cell--compact",
  ]}
  href={`/teams/${constructorId}`}
>
  {logo ? (
    <img
      class:list={[
        "vendor-cell__logo",
        logoVariantFor(vendorIndexes, constructorId) === "white" && "vendor-cell__logo--chip",
      ]}
      src={logo}
      alt=""
      loading="lazy"
    />
  ) : null}
  <span class="vendor-cell__name">{constructorName}</span>
</a>
