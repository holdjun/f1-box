---
import type { SeasonPayload } from "@f1-box/contracts/season";

interface Props {
  freshness: SeasonPayload["freshness"];
}

const { freshness } = Astro.props;
const labels: Record<SeasonPayload["freshness"], string> = {
  fresh: "Fresh",
  delayed: "Delayed",
  stale: "Stale",
  unavailable: "Unavailable",
};
---

<span
  class={`freshness-badge freshness-badge--${freshness}`}
  role="status"
  aria-label={`Data status: ${labels[freshness]}`}
>
  <span aria-hidden="true"></span>
  {labels[freshness]}
</span>
