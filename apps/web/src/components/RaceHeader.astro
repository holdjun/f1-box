---
import { circuitTimeZone } from "../lib/circuit-time.js";
import type { RaceMeta } from "../lib/race-results-repository.js";
import { formatRaceDate } from "../lib/time.js";

interface Props {
  meta: RaceMeta;
}
const { meta } = Astro.props;
const round = String(meta.round).padStart(2, "0");
// 副行日期在 formatRaceDate 内回退：空 time 或无时区映射的历史赛保持 UTC，不做时区换算
const raceDate = formatRaceDate(
  meta.date,
  meta.raceTime,
  circuitTimeZone(meta.circuitId),
);
---

<header class="shell flex flex-wrap items-baseline gap-x-4 gap-y-2 pt-6 md:pt-8">
  <span
    class="font-display text-[0.8rem] font-semibold tracking-[0.12em] text-ink-muted"
    >R{round}</span>
  <img
    src={`/vendor/country-flags/${meta.alpha2Code.toLowerCase()}.svg`}
    alt=""
    class="vendor-cell__flag h-4 w-auto aspect-4/3"
  />
  <h1 class="text-display-md">{meta.name}</h1>
  <p class="race-hero__subtitle text-[0.95rem] text-ink-muted">
    {raceDate} · {meta.circuitPlace} · {meta.countryName}
  </p>
</header>
