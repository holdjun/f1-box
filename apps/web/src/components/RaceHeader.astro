---
import { circuitTimeZone } from "../lib/circuit-time.js";
import type { RaceMeta } from "../lib/race-results-repository.js";
import { formatRaceDate } from "../lib/time.js";

interface Props {
  meta: RaceMeta;
}
const { meta } = Astro.props;
const round = String(meta.round).padStart(2, "0");
// 副行日期在 formatRaceDate 内回退：空 time 或无时区映射的历史赛保持 UTC，不做时区换算
const raceDate = formatRaceDate(
  meta.date,
  meta.raceTime,
  circuitTimeZone(meta.circuitId),
);
---

<!-- isolate: 让 -z-1 的描边数字压到正文之下, 又不至于沉到 body 背景后面 -->
<header class="shell relative isolate overflow-hidden pt-6 pb-8 md:pt-8">
  <!-- 描边巨型回合号: -z-1 沉到文字下方 (旧 z-index:-1 布局的等价表达) -->
  <p
    class="absolute -top-8 -left-[0.05em] -z-1 font-display text-[clamp(13rem,29vw,17rem)] leading-[0.7] font-bold text-transparent [-webkit-text-stroke:1px_var(--line)] max-md:text-[17rem]"
    aria-hidden="true"
  >{round}</p>
  <h1 class="max-w-[10ch] text-display-xl">{meta.name}</h1>
  <p class="race-hero__subtitle mt-6 text-[1.1rem]">
    {raceDate} · {meta.circuitPlace} · {meta.countryName}
  </p>
</header>
