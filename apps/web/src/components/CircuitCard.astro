---
import type { RaceMeta } from "../lib/race-results-repository.js";

interface Props {
  meta: RaceMeta;
}
const { meta } = Astro.props;

// 本场值（course_length/distance/turns/direction/laps 在 race 表均 NOT NULL），
// 可空只有 firstGrandPrix 与 recordLap；空值显示 "—"
const stats: { label: string; value: string }[] = [
  { label: "Circuit Length", value: `${meta.courseLength.toFixed(3)} km` },
  { label: "Number of Laps", value: String(meta.laps) },
  { label: "Race Distance", value: `${meta.distance.toFixed(3)} km` },
  { label: "Direction", value: meta.direction },
  { label: "Turns", value: String(meta.turns) },
  {
    label: "First Grand Prix",
    value: meta.firstGrandPrix === null ? "—" : String(meta.firstGrandPrix),
  },
  { label: "Races Held", value: String(meta.totalRacesHeld) },
];
---

<div class="info-panel">
  <h2>{meta.circuitFullName}</h2>
  <dl>
    {stats.map(({ label, value }) => (
      <div>
        <dt>{label}</dt>
        <dd>{value}</dd>
      </div>
    ))}
    <div class="col-span-full">
      <dt>Fastest Lap</dt>
      <dd>
        {meta.recordLap ? meta.recordLap.time : "—"}
        {meta.recordLap ? (
          <span class="ml-2 font-sans text-[0.9rem] font-normal text-ink-muted">
            {meta.recordLap.driverName} ({meta.recordLap.year})
          </span>
        ) : null}
      </dd>
    </div>
  </dl>
</div>
