---
import SeasonError from "../../../components/SeasonError.astro";
import TrendChart from "../../../components/TrendChart.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { driverGrid, driverSeries } from "../../../lib/derive.js";
import { resolveYearContext } from "../../../lib/year-context.js";
import { teamColor } from "../../../lib/tokens.js";

const ctx = await resolveYearContext(Astro);
const code = (Astro.params.driver ?? "").toUpperCase();
const driver = ctx.season ? driverGrid(ctx.season).find((d) => d.code === code) : undefined;
const standing = ctx.season?.driverStandings.find((row) => row.code === code);
const missingEntity = ctx.season !== undefined && driver === undefined;
if (ctx.status || missingEntity) Astro.response.status = 404;
const { year, index, season, rest } = ctx;
const errStatus = ctx.status ?? 404;
const series = season && driver ? driverSeries(season, driver.code) : [];
---

{season && driver && !ctx.status && !missingEntity ? (
  <BaseLayout title={driver.name} active="drivers" year={year} availableYears={index.availableYears} rest={rest}>
    <main id="main-content" class="page-shell">
      <p class="crumb"><a href={`/${year}/drivers`}>All drivers</a></p>
      <header class="driver-hero" style={`--team-color: ${teamColor(driver.team)}`}>
        <h1>{driver.name}</h1>
        <p>{driver.team} · {driver.code}</p>
      </header>

      <section class="stat-row" aria-label="Season statistics">
        <div><span>Season position</span><strong>{driver.position}</strong></div>
        <div><span>Points</span><strong>{driver.points}</strong></div>
        <div><span>Wins</span><strong>{standing?.wins ?? 0}</strong></div>
      </section>

      <section aria-labelledby="form-title">
        <h2 id="form-title">Race-by-race finish ({season.season})</h2>
        <TrendChart points={series} invert color={teamColor(driver.team)} label={`Finishing position by round, ${season.season}`} />
      </section>
    </main>
  </BaseLayout>
) : (
  <SeasonError year={year} index={index} rest={rest} status={errStatus} />
)}

<style>
  .crumb a { color: inherit; opacity: 0.7; }
  .driver-hero { padding: 1.5rem; border-radius: 12px; color: #fff; background: linear-gradient(135deg, color-mix(in srgb, var(--team-color) 70%, black), var(--team-color)); }
  .stat-row { display: flex; gap: 2rem; margin-block: 1.5rem; }
  .stat-row div { display: flex; flex-direction: column; }
  .stat-row span { font-size: 0.8rem; opacity: 0.7; }
  .stat-row strong { font-size: 1.5rem; }
</style>
