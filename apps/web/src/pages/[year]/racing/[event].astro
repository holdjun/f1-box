---
import FreshnessBadge from "../../../components/FreshnessBadge.astro";
import ResultTable from "../../../components/ResultTable.astro";
import SeasonError from "../../../components/SeasonError.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { resolveYearContext } from "../../../lib/year-context.js";
import { formatUtcDateTime } from "../../../lib/time.js";

const ctx = await resolveYearContext(Astro);
const eventKey = Astro.params.event ?? "";
const event = ctx.season?.events.find(
  (candidate) => `${candidate.round}-${candidate.slug}` === eventKey,
);
const missingEntity = ctx.season !== undefined && event === undefined;
if (ctx.status || missingEntity) Astro.response.status = 404;
const { year, index, season, rest } = ctx;
const errStatus = ctx.status ?? 404;

const eventIndex = event && season ? season.events.indexOf(event) : -1;
const previous = eventIndex > 0 ? season?.events[eventIndex - 1] : undefined;
const next = eventIndex >= 0 ? season?.events[eventIndex + 1] : undefined;
const round = event ? String(event.round).padStart(2, "0") : "";
const raceBase = `/${year}/racing`;
---

{season && event && !ctx.status && !missingEntity ? (
  <BaseLayout title={event.raceName} year={year} availableYears={index.availableYears} rest={rest}>
    <main id="main-content">
      <header class="race-hero page-shell">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={raceBase}>{season.season} Season</a>
          <span aria-hidden="true">/</span>
          <span>Round {round}</span>
        </nav>
        <div class="race-hero__title">
          <p class="giant-round" aria-hidden="true">{round}</p>
          <div>
            <div class="race-hero__status">
              <span class="status-label">{event.state.toUpperCase()}</span>
              <FreshnessBadge freshness={season.freshness} />
            </div>
            <h1>{event.raceName}</h1>
            <p>{event.circuit.locality}, {event.circuit.country}</p>
            <p class="muted">{event.circuit.name}</p>
          </div>
        </div>
      </header>

      <section class="weekend-section page-shell section-block" aria-labelledby="weekend-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker">ROUND {round}</p>
            <h2 id="weekend-title">Weekend schedule</h2>
          </div>
        </div>
        <ol class="weekend-schedule">
          {event.sessions.map((session) => (
            <li>
              <span class="session-index" aria-hidden="true">
                {String(event.sessions.indexOf(session) + 1).padStart(2, "0")}
              </span>
              <div>
                <h3>{session.name}</h3>
                <time datetime={session.startsAt}>{formatUtcDateTime(session.startsAt)}</time>
                <span data-local-time data-timestamp={session.startsAt} hidden></span>
              </div>
              <span class="status-label">{session.state.toUpperCase()}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="results-section section-band" aria-labelledby="qualifying-title">
        <div class="page-shell">
          <div class="section-heading section-heading--light">
            <div>
              <p class="section-kicker">SATURDAY ORDER</p>
              <h2 id="qualifying-title">Qualifying classification</h2>
            </div>
          </div>
          <ResultTable kind="qualifying" classification={event.qualifyingClassification} />
        </div>
      </section>

      <section class="results-section page-shell section-block" aria-labelledby="race-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker">SUNDAY ORDER</p>
            <h2 id="race-title">Race classification</h2>
          </div>
        </div>
        <ResultTable kind="race" classification={event.raceClassification} />
      </section>

      <nav class="race-navigation page-shell" aria-label="Race navigation">
        {previous && (
          <a href={`${raceBase}/${previous.round}-${previous.slug}`}>
            <span>Previous ·</span>
            {previous.raceName}
          </a>
        )}
        <a class="race-navigation__season" href={raceBase}>Back to {season.season} season</a>
        {next && (
          <a class="race-navigation__next" href={`${raceBase}/${next.round}-${next.slug}`}>
            <span>Next ·</span>
            {next.raceName}
          </a>
        )}
      </nav>
    </main>
  </BaseLayout>
) : (
  <SeasonError year={year} index={index} rest={rest} status={errStatus} />
)}
