---
import SeasonError from "../../../components/SeasonError.astro";
import TrendChart from "../../../components/TrendChart.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { teamGrid, teamSeries } from "../../../lib/derive.js";
import { resolveYearContext } from "../../../lib/year-context.js";
import { teamColor } from "../../../lib/tokens.js";

const ctx = await resolveYearContext(Astro);
const slug = (Astro.params.team ?? "").toLowerCase();
const team = ctx.season
  ? teamGrid(ctx.season).find((t) => t.name.toLowerCase().replace(/\s+/g, "-") === slug)
  : undefined;
const standing = ctx.season?.constructorStandings.find((row) => row.name === team?.name);
const missingEntity = ctx.season !== undefined && team === undefined;
if (ctx.status || missingEntity) Astro.response.status = 404;
const { year, index, season, rest } = ctx;
const errStatus = ctx.status ?? 404;
const series = season && team ? teamSeries(season, team.name) : [];
---

{season && team && !ctx.status && !missingEntity ? (
  <BaseLayout title={team.name} active="teams" year={year} availableYears={index.availableYears} rest={rest}>
    <main id="main-content" class="page-shell">
      <p class="crumb"><a href={`/${year}/teams`}>All teams</a></p>
      <header class="team-hero" style={`--team-color: ${teamColor(team.name)}`}>
        <h1>{team.name}</h1>
        <p>{team.drivers.join(" · ")}</p>
      </header>

      <section class="stat-row" aria-label="Season statistics">
        <div><span>Season position</span><strong>{team.position}</strong></div>
        <div><span>Points</span><strong>{team.points}</strong></div>
        <div><span>Wins</span><strong>{standing?.wins ?? 0}</strong></div>
      </section>

      <section aria-labelledby="points-title">
        <h2 id="points-title">Points by round ({season.season})</h2>
        <TrendChart points={series} color={teamColor(team.name)} label={`Points scored by round, ${season.season}`} />
      </section>
    </main>
  </BaseLayout>
) : (
  <SeasonError year={year} index={index} rest={rest} status={errStatus} />
)}

<style>
  .crumb a { color: inherit; opacity: 0.7; }
  .team-hero { padding: 1.5rem; border-radius: 12px; color: #fff; background: linear-gradient(135deg, color-mix(in srgb, var(--team-color) 70%, black), var(--team-color)); }
  .stat-row { display: flex; gap: 2rem; margin-block: 1.5rem; }
  .stat-row div { display: flex; flex-direction: column; }
  .stat-row span { font-size: 0.8rem; opacity: 0.7; }
  .stat-row strong { font-size: 1.5rem; }
</style>
