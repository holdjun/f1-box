---
import { env } from "cloudflare:workers";

import BaseLayout from "../../layouts/BaseLayout.astro";
import CurrentSeasonPanel from "../../components/CurrentSeasonPanel.astro";
import HistoryEnd from "../../components/HistoryEnd.astro";
import SeasonMatrix from "../../components/SeasonMatrix.astro";
import {
  createD1TeamDatabase,
  createTeamRepository,
} from "../../lib/team-repository.js";
import { resolveSeasonSelection } from "../../lib/routing.js";
import {
  colorForYear,
  getTeamBranding,
  latestColor,
  vendorIndexes,
} from "../../lib/vendor.js";

const slug = (Astro.params.slug ?? "").toLowerCase();
const repository = import.meta.env.DEV
  ? createTeamRepository()
  : createTeamRepository(createD1TeamDatabase(env.F1_DB));

const team = await repository.getTeam(slug);
if (!team) Astro.response.status = 404;

const branding = getTeamBranding(vendorIndexes, slug);

// 上游数据最快 30 分钟更新一次，边缘短暂缓存可吸收重复请求
if (team) {
  Astro.response.headers.set(
    "Cache-Control",
    "public, s-maxage=300, stale-while-revalidate=600",
  );
}

const currentYear = team?.activeSeason ?? null;
const standaloneLineage = team?.lineage.filter((entry) => entry.segment === "standalone") ?? [];
const continuityLineage = team?.lineage.filter((entry) => entry.segment === "continuity") ?? [];
// lineage chip 用该身份期末的队色（与车手页 stint chip 同口径），当前身份取最新色
const lineageColor = (yearTo: number | null, id: string) =>
  (yearTo === null
    ? latestColor(vendorIndexes, id)
    : colorForYear(vendorIndexes, id, yearTo)) ?? "#84909e";
const flagSrc = team ? `/vendor/country-flags/${team.alpha2Code.toLowerCase()}.svg` : null;

const matrixSeasons = (team?.seasons ?? []).map((season) => ({
  year: season.year,
  metaText: [season.chassis.join(" / "), season.engines.join(" / ")]
    .filter((part) => part.length > 0)
    .join(" · "),
  metaLinks: [],
  tyres: season.tyres,
  rounds: season.rounds,
  rows: season.drivers.map((driver) => ({
    name: driver.name,
    href: `/drivers/${driver.id}`,
    flagCode: driver.flagCode,
    highlight: driver.champion,
    results: driver.results,
  })),
  points: season.points,
  position: season.position,
  championshipWon: season.championshipWon,
  current: season.year === currentYear,
}));

// ?year=1997,2007 只显示这些赛季（筛选状态可分享/后退）
const initialSelected = resolveSeasonSelection(
  Astro.url.searchParams.get("year"),
  new Set((team?.seasons ?? []).map((s) => s.year)),
);

const lineageLabel = "lineage-label mr-1.5 text-[0.68rem] uppercase tracking-[0.1em] text-ink-muted";
const lineageYears = "lineage-years text-[0.68rem] text-ink-muted";
const chipClasses =
  "lineage-chip inline-flex items-baseline gap-1.5 rounded-full border px-2.5 py-0.5 transition-colors hover:underline";
---

{team ? (
  <BaseLayout
    title={team.name}
    description={`${team.fullName} — career statistics and complete race-by-race history.`}
    active="teams"
  >
    <main id="main-content" class="shell pt-12 pb-section">
      <header class="flex flex-col gap-6 md:flex-row md:items-center">
        <span class="team-logo-frame grid h-16 w-24 flex-none place-items-center rounded-md border border-line bg-surface-raised p-2 light:shadow-panel">
          {branding.logoSrc ? (
            /* 深色稿 logo 白底托（双主题）；白色稿 logo 亮色下换墨底托，深色下保留投影 */
            <img
              class:list={[
                "team-logo block size-full min-w-0 min-h-0 flex-none object-contain",
                branding.logoVariant !== "white"
                  ? "logo-on-light box-border rounded-[0.5rem] bg-white/[0.94] px-[0.7rem] py-[0.45rem]"
                  : "light:box-border light:rounded-[0.5rem] light:bg-ink light:px-[0.7rem] light:py-[0.45rem] [filter:drop-shadow(0_4px_10px_rgb(0_0_0/0.35))] light:[filter:none]",
              ]}
              src={branding.logoSrc}
              alt=""
            />
          ) : (
            <span class="team-monogram grid size-16 flex-none place-items-center rounded-[12px] bg-line font-display text-[1.6rem] font-bold text-ink-strong" aria-hidden="true"
              >{team.name.slice(0, 2).toUpperCase()}</span
            >
          )}
        </span>
        <div>
          <h1 class="max-w-[12ch] text-display-lg uppercase">{team.fullName}</h1>
          <p class="team-country mt-3 flex items-center gap-1.5 text-[0.85rem] uppercase tracking-[0.06em] text-ink-strong">
            {flagSrc ? <img class="flag h-[0.95rem] w-auto" src={flagSrc} alt="" /> : null}
            {team.countryName}
          </p>
        </div>
      </header>

      {team.lineage.length > 0 ? (
        <div class="mt-6 grid gap-2.5 text-[0.78rem]" aria-label="Team lineage">
          {standaloneLineage.length > 0 ? (
            <div class="lineage-block flex flex-wrap items-center gap-1.5">
              <span class={lineageLabel}>Earlier entries</span>
              <div class="lineage-list flex flex-wrap items-center gap-1.5">
                {standaloneLineage.map((entry, index) => (
                  <span class="lineage-item inline-flex items-center gap-1.5">
                    {index > 0 ? <span class="lineage-separator text-ink-muted">·</span> : null}
                    <a
                      class={chipClasses}
                      href={`/teams/${entry.id}`}
                      style={`--chip-color: ${lineageColor(entry.yearTo, entry.id)}`}
                    >
                      {entry.name}
                      <span class={lineageYears}>
                        {entry.yearTo === null || entry.yearTo === entry.yearFrom
                          ? entry.yearFrom
                          : `${entry.yearFrom}–${entry.yearTo}`}
                      </span>
                    </a>
                  </span>
                ))}
              </div>
            </div>
          ) : null}
          {continuityLineage.length > 0 ? (
            <div class="lineage-block flex flex-wrap items-center gap-1.5">
              <span class={lineageLabel}>Constructor continuity</span>
              <div class="lineage-list flex flex-wrap items-center gap-1.5">
                {continuityLineage.map((entry, index) => (
                  <span class="lineage-item inline-flex items-center gap-1.5">
                    {index > 0 ? <span class="lineage-arrow text-ink-muted">→</span> : null}
                    <a
                      class={chipClasses}
                      href={`/teams/${entry.id}`}
                      style={`--chip-color: ${lineageColor(entry.yearTo, entry.id)}`}
                    >
                      {entry.name}
                      <span class={lineageYears}>
                        {entry.yearTo === null || entry.yearTo === entry.yearFrom
                          ? entry.yearFrom
                          : `${entry.yearFrom}–${entry.yearTo}`}
                      </span>
                    </a>
                  </span>
                ))}
              </div>
            </div>
          ) : null}
        </div>
      ) : null}

      <section class="info-panels">
        {team.currentSeason && team.currentSeason.year === currentYear ? (
          <CurrentSeasonPanel season={team.currentSeason} />
        ) : null}
        <div class="info-panel" aria-label="Team summary">
          <h2>Team Summary</h2>
          <dl>
            <div><dt>Entries</dt><dd>{team.totals.entries}</dd></div>
            <div><dt>Wins</dt><dd>{team.totals.wins}</dd></div>
            <div><dt>Podiums</dt><dd>{team.totals.podiums}</dd></div>
            <div><dt>Poles</dt><dd>{team.totals.poles}</dd></div>
            <div><dt>Fastest laps</dt><dd>{team.totals.fastestLaps}</dd></div>
            <div><dt>Points</dt><dd>{team.totals.points}</dd></div>
            <div><dt>Championships</dt><dd>{team.totals.championships}</dd></div>
            <div>
              <dt>Best position</dt>
              <dd>{team.totals.bestChampionshipPosition ?? "—"}</dd>
            </div>
            <div><dt>First Team Entry</dt><dd>{team.firstEntry}</dd></div>
          </dl>
        </div>
      </section>

      <section class="mt-12" aria-labelledby="history-title">
        <h2 id="history-title" class="mb-2 text-2xl">Season results</h2>
        <SeasonMatrix
          seasons={matrixSeasons}
          rowLabel="Driver"
          showChampionKey
          initialSelected={initialSelected}
        />
        <HistoryEnd
          summary={`${team.firstEntry}–${team.seasons[0]?.year ?? team.activeSeason} · ${team.seasons.length} ${team.seasons.length === 1 ? "season" : "seasons"} of Grand Prix history`}
          backHref="/teams"
          backLabel="Back to all teams"
        />
      </section>
    </main>
  </BaseLayout>
) : (
  <BaseLayout title="Team not found">
    <main id="main-content" class="shell pt-12 pb-section">
      <h1 class="title-page">Team not found</h1>
      <p class="mt-4 text-ink-strong">No constructor with this identifier exists in the database.</p>
    </main>
  </BaseLayout>
)}

<style>
  /* 身份名用该时期末的队色（--chip-color 行内下发，数据语义色例外），缺配色在数据层回落灰 */
  a.lineage-chip {
    border-color: color-mix(in srgb, var(--chip-color) 45%, transparent);
    color: var(--chip-color);
  }
  /* 队色可能是白等浅色：亮色主题混入 ink 保住对比度 */
  :global([data-theme="light"]) a.lineage-chip {
    border-color: color-mix(in srgb, var(--chip-color) 45%, var(--line));
    color: color-mix(in srgb, var(--chip-color) 55%, var(--ink));
  }
</style>
