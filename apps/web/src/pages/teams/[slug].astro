---
import { env } from "cloudflare:workers";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { createTeamRepository } from "../../lib/team-repository.js";
import { alpha2Flag } from "../../lib/tokens.js";
import { getTeamBranding } from "../../lib/vendor.js";

const slug = (Astro.params.slug ?? "").toLowerCase();
const repository = import.meta.env.DEV
  ? createTeamRepository()
  : createTeamRepository(env.F1_DB);
const store = import.meta.env.DEV ? undefined : env.F1_DATA;

const [team, branding] = await Promise.all([
  repository.getTeam(slug),
  getTeamBranding(store, slug),
]);
if (!team) Astro.response.status = 404;

const currentYear = team?.seasons[0]?.year;
const flagSrc = store
  ? `/vendor/country-flags/${team?.alpha2Code.toLowerCase()}.svg`
  : null;

function resultClass(text: string): string {
  if (text === "1") return "result-win";
  if (text === "2" || text === "3") return "result-podium";
  if (/^\d+$/.test(text)) {
    return Number(text) <= 10 ? "result-points" : "result-finish";
  }
  if (text === "Ret" || text === "DNF") return "result-ret";
  if (text === "DSQ" || text === "EX") return "result-dsq";
  if (text === "DNQ" || text === "DNPQ") return "result-dnq";
  return "result-other";
}
---

{team ? (
  <BaseLayout
    title={team.name}
    description={`${team.fullName} — career statistics and complete race-by-race history.`}
    active="teams"
  >
    <main id="main-content" class="page-shell">
      <header
        class="team-hero"
        style={`--team-color: ${branding.color ?? "#84909e"}`}
      >
        {branding.logoSrc ? (
          <img class="team-logo" src={branding.logoSrc} alt="" />
        ) : (
          <span class="team-monogram" aria-hidden="true"
            >{team.name.slice(0, 2).toUpperCase()}</span
          >
        )}
        <div>
          <h1>{team.fullName}</h1>
          <p class="team-country">
            {flagSrc ? <img class="flag" src={flagSrc} alt="" /> : null}
            {team.countryName}
          </p>
        </div>
      </header>

      <section class="stat-row" aria-label="Career statistics">
        <div><span>Entries</span><strong>{team.totals.entries}</strong></div>
        <div><span>Wins</span><strong>{team.totals.wins}</strong></div>
        <div><span>Podiums</span><strong>{team.totals.podiums}</strong></div>
        <div><span>Poles</span><strong>{team.totals.poles}</strong></div>
        <div>
          <span>Fastest laps</span><strong>{team.totals.fastestLaps}</strong>
        </div>
        <div><span>Points</span><strong>{team.totals.points}</strong></div>
        <div>
          <span>Championships</span><strong>{team.totals.championships}</strong>
        </div>
        <div>
          <span>Best position</span
          ><strong>{team.totals.bestChampionshipPosition ?? "—"}</strong>
        </div>
      </section>

      <section class="info-panels">
        {team.currentSeason ? (
          <div class="info-panel" aria-label={`${team.currentSeason.year} season`}>
            <h2>{team.currentSeason.year} Season</h2>
            <dl>
              <div><dt>Season Position</dt><dd>{team.currentSeason.position ?? "—"}</dd></div>
              <div><dt>Season Points</dt><dd>{team.currentSeason.points ?? "—"}</dd></div>
              <div><dt>Grand Prix Races</dt><dd>{team.currentSeason.grandPrix.races}</dd></div>
              <div><dt>Grand Prix Points</dt><dd>{team.currentSeason.grandPrix.points}</dd></div>
              <div><dt>Grand Prix Wins</dt><dd>{team.currentSeason.grandPrix.wins}</dd></div>
              <div><dt>Grand Prix Podiums</dt><dd>{team.currentSeason.grandPrix.podiums}</dd></div>
              <div><dt>Grand Prix Poles</dt><dd>{team.currentSeason.grandPrix.poles}</dd></div>
              <div><dt>Grand Prix Top 10s</dt><dd>{team.currentSeason.grandPrix.top10s}</dd></div>
              <div><dt>Fastest Laps</dt><dd>{team.currentSeason.grandPrix.fastestLaps}</dd></div>
              <div><dt>DNFs</dt><dd>{team.currentSeason.grandPrix.dnfs}</dd></div>
              <div><dt>Sprint Races</dt><dd>{team.currentSeason.sprint.races}</dd></div>
              <div><dt>Sprint Points</dt><dd>{team.currentSeason.sprint.points}</dd></div>
              <div><dt>Sprint Wins</dt><dd>{team.currentSeason.sprint.wins}</dd></div>
              <div><dt>Sprint Podiums</dt><dd>{team.currentSeason.sprint.podiums}</dd></div>
              <div><dt>Sprint Poles</dt><dd>{team.currentSeason.sprint.poles}</dd></div>
              <div><dt>Sprint Top 10s</dt><dd>{team.currentSeason.sprint.top10s}</dd></div>
            </dl>
          </div>
        ) : null}
        <div class="info-panel" aria-label="Team summary">
          <h2>Team Summary</h2>
          <dl>
            <div><dt>Full Team Name</dt><dd>{team.fullName}</dd></div>
            <div><dt>Country</dt><dd>{team.countryName}</dd></div>
            {team.seasons[0] ? (
              <>
                <div><dt>Chassis</dt><dd>{team.seasons[0].chassis.join(" / ")}</dd></div>
                <div><dt>Power Unit</dt><dd>{team.seasons[0].powerUnits.join(" / ")}</dd></div>
                <div><dt>Tyres</dt><dd>{team.seasons[0].tyres.join(" / ")}</dd></div>
              </>
            ) : null}
            <div><dt>First Team Entry</dt><dd>{team.firstEntry}</dd></div>
          </dl>
        </div>
      </section>

      <section aria-labelledby="history-title">
        <h2 id="history-title">Season results</h2>
        <p class="legend" aria-label="Table legend">
          <span class="key"><i class="result-win"></i>Win</span>
          <span class="key"><i class="result-podium"></i>Podium</span>
          <span class="key"><i class="result-points"></i>Points</span>
          <span class="key"><i class="result-ret"></i>Retired</span>
          <span class="key"><i class="result-dnq"></i>DNQ</span>
          <span class="key"><i class="result-dsq"></i>DSQ</span>
          <span class="key"><sup class="sup-p">P</sup>pole position</span>
          <span class="key"><sup class="sup-f">F</sup>fastest lap</span>
          <span class="key"><sup class="sup-sprint">n</sup>sprint points</span>
          <span class="key"><span class="dagger">†</span>retired but classified</span>
        </p>
        {team.seasons.map((season) => (
          <section
            class:list={[
              "season-block",
              {
                champion: season.championshipWon,
                current: season.year === currentYear,
              },
            ]}
          >
            <h3>
              <span class="season-year">{season.year}</span>
              <span class="season-meta">
                {[season.chassis.join(" / "), season.engines.join(" / ")]
                  .filter((part) => part.length > 0)
                  .join(" · ")}
              </span>
              {season.tyres.map((tyre) => (
                <span class={`tyre-badge tyre-${tyre}`} title={`Tyres: ${tyre}`}>
                  {tyre}
                </span>
              ))}
              <span class="season-pts">
                {season.points ?? "—"} pts · P{season.position ?? "—"}
              </span>
            </h3>
            <div class="table-scroll" tabindex="0">
              <table aria-label={`${season.year} race results`}>
                <thead>
                  <tr>
                    <th scope="col" class="driver-col">Driver</th>
                    {season.rounds.map((round) => (
                      <th scope="col" title={round.name}>{round.code}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {season.drivers.length === 0 ? (
                    <tr>
                      <td class="empty-cell" colspan={season.rounds.length + 1}>
                        No race entries recorded.
                      </td>
                    </tr>
                  ) : (
                    season.drivers.map((driver) => (
                      <tr>
                        <th scope="row" class="driver-cell">
                          {driver.flagCode ? (
                            <span class="flag-emoji" aria-hidden="true">
                              {alpha2Flag(driver.flagCode)}
                            </span>
                          ) : null}
                          <a class="driver-link" href={`/drivers/${driver.id}`}>
                            {driver.name}
                          </a>
                        </th>
                        {driver.results.map((cell) =>
                          cell ? (
                            <td class={resultClass(cell.text)}>
                              {cell.text}
                              {cell.classified ? <span class="dagger">†</span> : null}
                              {cell.pole ? <sup class="sup-p">P</sup> : null}
                              {cell.fastest ? <sup class="sup-f">F</sup> : null}
                              {cell.sprintPoints !== null ? (
                                <sup class="sup-sprint">{cell.sprintPoints}</sup>
                              ) : null}
                            </td>
                          ) : (
                            <td class="result-none"></td>
                          ),
                        )}
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </section>
        ))}
        <p class="source-note">Historical data: f1db (CC BY 4.0)</p>
      </section>
    </main>
  </BaseLayout>
) : (
  <BaseLayout title="Team not found">
    <main id="main-content" class="page-shell">
      <h1>Team not found</h1>
      <p>No constructor with this identifier exists in the database.</p>
    </main>
  </BaseLayout>
)}

<style>
  .team-hero {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: 12px;
    color: #fff;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--team-color) 70%, black),
      var(--team-color)
    );
  }
  .team-logo {
    height: 3.5rem;
    width: auto;
    flex: none;
  }
  .team-monogram {
    display: grid;
    place-items: center;
    height: 3.5rem;
    width: 3.5rem;
    flex: none;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.3);
    font-size: 1.4rem;
    font-weight: 700;
  }
  .team-hero h1 {
    margin: 0;
  }
  .team-country {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.25rem 0 0;
    opacity: 0.85;
  }
  .flag {
    height: 0.95rem;
    width: auto;
  }
  .stat-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    margin-block: 1.5rem;
  }
  .stat-row div {
    display: flex;
    flex-direction: column;
  }
  .stat-row span {
    font-size: 0.8rem;
    opacity: 0.7;
  }
  .stat-row strong {
    font-size: 1.5rem;
  }
  .info-panels {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }
  .info-panel {
    flex: 1 1 18rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .info-panel h2 {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }
  .info-panel dl {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 0.6rem 1rem;
    margin: 0;
  }
  .info-panel dt {
    font-size: 0.68rem;
    color: var(--muted);
  }
  .info-panel dd {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .tyre-badge {
    display: inline-grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 3px;
    font-size: 0.7rem;
    font-weight: 700;
  }
  .tyre-P { background: #ffd12e; color: #c00000; }
  .tyre-B { background: #cc0000; color: #fff; }
  .tyre-M { background: #1f6bb5; color: #fff; }
  .tyre-G { background: #2a8fbd; color: #fff; }
  .tyre-D { background: #2e8b57; color: #fff; }
  .tyre-F { background: #b03a2e; color: #fff; }
  .sup-p,
  .sup-f,
  .sup-sprint {
    font-size: 0.55rem;
    font-weight: 700;
  }
  .sup-p { color: #ffc72c; }
  .sup-f { color: #b06ef7; }
  .sup-sprint { color: #ff8c42; }
  .dagger {
    font-size: 0.7rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0.5rem 0 0;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .key i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 3px;
  }
  .driver-link {
    color: inherit;
    text-decoration: none;
  }
  .driver-link:hover {
    color: var(--paper);
    text-decoration: underline;
  }
  .season-block {
    margin-top: 1.75rem;
    /* 77 块全量渲染，视口外的块跳过布局与绘制，滚动时按需生成 */
    content-visibility: auto;
    contain-intrinsic-size: auto 14rem;
  }
  .season-block h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 0.4rem;
  }
  .season-year {
    font-size: 1.1rem;
    font-weight: 700;
  }
  .season-meta {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .season-pts {
    margin-left: auto;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .season-block.champion h3 {
    color: #ffc72c;
  }
  .season-block.current h3 {
    color: var(--paper);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .driver-col {
    min-width: 11rem;
  }
  .driver-cell {
    min-width: 11rem;
  }
  .flag-emoji {
    margin-right: 0.35rem;
  }
  table th[scope="col"]:not(.driver-col) {
    padding-inline: 0.45rem;
    font-size: 0.6rem;
  }
  table td {
    padding-inline: 0.45rem;
    text-align: center;
  }
  table td sup {
    font-size: 0.55rem;
  }
  .result-win {
    background: rgba(247, 201, 72, 0.32);
    color: #ffe9a8;
  }
  .result-podium {
    background: rgba(126, 212, 145, 0.25);
    color: #c8f2d3;
  }
  .result-points {
    background: rgba(167, 166, 243, 0.22);
    color: #d9d8fb;
  }
  .result-finish {
    color: var(--muted);
  }
  .result-ret {
    background: rgba(224, 143, 213, 0.22);
    color: #f0cdea;
  }
  .result-dsq {
    background: rgba(220, 80, 80, 0.3);
    color: #ffd7d7;
  }
  .result-dnq {
    background: rgba(240, 150, 120, 0.22);
    color: #f8d9cc;
  }
  .result-other {
    color: var(--muted);
  }
  .empty-cell {
    text-align: left !important;
    color: var(--muted);
  }
  .source-note {
    margin-top: 1.5rem;
    font-size: 0.72rem;
    color: var(--muted);
  }
</style>
