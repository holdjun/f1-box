---
import { env } from "cloudflare:workers";

import BaseLayout from "../../layouts/BaseLayout.astro";
import CurrentSeasonPanel from "../../components/CurrentSeasonPanel.astro";
import HistoryEnd from "../../components/HistoryEnd.astro";
import SeasonMatrix from "../../components/SeasonMatrix.astro";
import {
  createD1TeamDatabase,
  createTeamRepository,
} from "../../lib/team-repository.js";
import { parseYearParam } from "../../lib/routing.js";
import { getTeamBranding, vendorIndexes } from "../../lib/vendor.js";

const slug = (Astro.params.slug ?? "").toLowerCase();
const repository = import.meta.env.DEV
  ? createTeamRepository()
  : createTeamRepository(createD1TeamDatabase(env.F1_DB));

const team = await repository.getTeam(slug);
if (!team) Astro.response.status = 404;

const branding = getTeamBranding(vendorIndexes, slug);

// 上游数据最快 30 分钟更新一次，边缘短暂缓存可吸收重复请求
if (team) {
  Astro.response.headers.set(
    "Cache-Control",
    "public, s-maxage=300, stale-while-revalidate=600",
  );
}

const currentYear = team?.activeSeason ?? null;
const standaloneLineage = team?.lineage.filter((entry) => entry.segment === "standalone") ?? [];
const continuityLineage = team?.lineage.filter((entry) => entry.segment === "continuity") ?? [];
const flagSrc = team ? `/vendor/country-flags/${team.alpha2Code.toLowerCase()}.svg` : null;

const matrixSeasons = (team?.seasons ?? []).map((season) => ({
  year: season.year,
  metaText: [season.chassis.join(" / "), season.engines.join(" / ")]
    .filter((part) => part.length > 0)
    .join(" · "),
  metaHref: null,
  tyres: season.tyres,
  rounds: season.rounds,
  rows: season.drivers.map((driver) => ({
    name: driver.name,
    href: `/drivers/${driver.id}`,
    flagCode: driver.flagCode,
    highlight: driver.champion,
    results: driver.results,
  })),
  points: season.points,
  position: season.position,
  championshipWon: season.championshipWon,
  current: season.year === currentYear,
}));

// ?year=1997,2007 只显示这些赛季（筛选状态可分享/后退）
const initialSelected = (() => {
  const param = parseYearParam(Astro.url.searchParams.get("year"));
  if (param === null) return null;
  const seasonYears = new Set((team?.seasons ?? []).map((s) => s.year));
  const valid = param.filter((year) => seasonYears.has(year));
  return valid.length > 0 ? valid : null;
})();
---

{team ? (
  <BaseLayout
    title={team.name}
    description={`${team.fullName} — career statistics and complete race-by-race history.`}
    active="teams"
  >
    <main id="main-content" class="page-shell">
      <header
        class="team-hero"
        style={`--team-color: ${branding.colors[0] ?? "#84909e"}; --team-color-2: ${branding.colors[1] ?? branding.colors[0] ?? "#84909e"}`}
      >
        <span class="team-logo-frame">
          {branding.logoSrc ? (
            <img
              class:list={["team-logo", { "logo-on-light": branding.logoVariant !== "white" }]}
              src={branding.logoSrc}
              alt=""
            />
          ) : (
            <span class="team-monogram" aria-hidden="true"
              >{team.name.slice(0, 2).toUpperCase()}</span
            >
          )}
        </span>
        <div>
          <h1>{team.fullName}</h1>
          <p class="team-country">
            {flagSrc ? <img class="flag" src={flagSrc} alt="" /> : null}
            {team.countryName}
          </p>
        </div>
      </header>

      {team.lineage.length > 0 ? (
        <div class="lineage" aria-label="Team lineage">
          {standaloneLineage.length > 0 ? (
            <div class="lineage-block">
              <span class="lineage-label">Earlier entries</span>
              <div class="lineage-list">
                {standaloneLineage.map((entry, index) => (
                  <span class="lineage-item">
                    {index > 0 ? <span class="lineage-separator">·</span> : null}
                    <a class="lineage-chip" href={`/teams/${entry.id}`}>
                      {entry.name}
                      <span class="lineage-years">
                        {entry.yearTo === null || entry.yearTo === entry.yearFrom
                          ? entry.yearFrom
                          : `${entry.yearFrom}–${entry.yearTo}`}
                      </span>
                    </a>
                  </span>
                ))}
              </div>
            </div>
          ) : null}
          {continuityLineage.length > 0 ? (
            <div class="lineage-block">
              <span class="lineage-label">Constructor continuity</span>
              <div class="lineage-list">
                {continuityLineage.map((entry, index) => (
                  <span class="lineage-item">
                    {index > 0 ? <span class="lineage-arrow">→</span> : null}
                    <a class="lineage-chip" href={`/teams/${entry.id}`}>
                      {entry.name}
                      <span class="lineage-years">
                        {entry.yearTo === null || entry.yearTo === entry.yearFrom
                          ? entry.yearFrom
                          : `${entry.yearFrom}–${entry.yearTo}`}
                      </span>
                    </a>
                  </span>
                ))}
              </div>
            </div>
          ) : null}
        </div>
      ) : null}

      <section class="info-panels">
        {team.currentSeason && team.currentSeason.year === currentYear ? (
          <CurrentSeasonPanel season={team.currentSeason} />
        ) : null}
        <div class="info-panel" aria-label="Team summary">
          <h2>Team Summary</h2>
          <dl>
            <div><dt>Entries</dt><dd>{team.totals.entries}</dd></div>
            <div><dt>Wins</dt><dd>{team.totals.wins}</dd></div>
            <div><dt>Podiums</dt><dd>{team.totals.podiums}</dd></div>
            <div><dt>Poles</dt><dd>{team.totals.poles}</dd></div>
            <div><dt>Fastest laps</dt><dd>{team.totals.fastestLaps}</dd></div>
            <div><dt>Points</dt><dd>{team.totals.points}</dd></div>
            <div><dt>Championships</dt><dd>{team.totals.championships}</dd></div>
            <div>
              <dt>Best position</dt>
              <dd>{team.totals.bestChampionshipPosition ?? "—"}</dd>
            </div>
            <div><dt>First Team Entry</dt><dd>{team.firstEntry}</dd></div>
          </dl>
        </div>
      </section>

      <section aria-labelledby="history-title">
        <h2 id="history-title">Season results</h2>
        <SeasonMatrix
          seasons={matrixSeasons}
          rowLabel="Driver"
          showChampionKey
          initialSelected={initialSelected}
        />
        <HistoryEnd
          summary={`${team.firstEntry}–${team.seasons[0]?.year ?? team.activeSeason} · ${team.seasons.length} ${team.seasons.length === 1 ? "season" : "seasons"} of Grand Prix history`}
          backHref="/teams"
          backLabel="Back to all teams"
        />
      </section>
    </main>
  </BaseLayout>
) : (
  <BaseLayout title="Team not found">
    <main id="main-content" class="page-shell">
      <h1>Team not found</h1>
      <p>No constructor with this identifier exists in the database.</p>
    </main>
  </BaseLayout>
)}

<style>
  .team-hero {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 2.25rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    color: #fff;
    background:
      radial-gradient(120% 170% at 88% -30%, rgba(255, 255, 255, 0.25), transparent 55%),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--team-color) 72%, black),
        var(--team-color-2)
      );
    box-shadow: 0 20px 44px -24px color-mix(in srgb, var(--team-color) 65%, transparent);
  }
  .team-logo-frame {
    display: grid;
    place-items: center;
    width: 6rem;
    height: 4rem;
    flex: none;
  }
  .team-logo {
    display: block;
    min-width: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    flex: none;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.35));
  }
  .logo-on-light {
    box-sizing: border-box;
    padding: 0.45rem 0.7rem;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.94);
    filter: none;
  }
  .team-monogram {
    display: grid;
    place-items: center;
    height: 4rem;
    width: 4rem;
    flex: none;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.3);
    font-family: var(--display);
    font-size: 1.6rem;
    font-weight: 700;
  }
  .team-hero h1 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    letter-spacing: 0.01em;
  }
  .team-country {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.3rem 0 0;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .flag {
    height: 0.95rem;
    width: auto;
  }
  .lineage {
    display: grid;
    gap: 0.65rem;
    margin: 1rem 0 0;
    font-size: 0.78rem;
  }
  .lineage-block {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .lineage-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .lineage-label {
    margin-right: 0.3rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.68rem;
  }
  .lineage-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .lineage-arrow {
    color: var(--muted);
  }
  .lineage-separator {
    color: var(--muted);
  }
  .lineage-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted-light);
    text-decoration: none;
  }
  .lineage-chip:hover {
    border-color: var(--coral);
    color: var(--coral);
  }
  .lineage-years {
    color: var(--muted);
    font-size: 0.68rem;
  }
</style>
