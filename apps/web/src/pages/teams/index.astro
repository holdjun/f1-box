---
import SeasonFilter from "../../components/SeasonFilter.svelte";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { gridFillers } from "../../lib/layout.js";
import { resolveCatalogYear } from "../../lib/routing.js";
import {
  logoSrcFor,
  logoVariantFor,
  vendorIndexes,
} from "../../lib/vendor.js";

const { team: teamRepository } = Astro.locals.app.repositories;
const years = await teamRepository.getSeasonYears();
const year = resolveCatalogYear(Astro.url.searchParams.get("year"), years);
const constructors =
  year === null
    ? await teamRepository.getConstructors()
    : await teamRepository.getConstructorsByYear(year);

const cardClasses =
  "team-card group relative flex flex-col items-center gap-3 rounded-md bg-surface-raised p-5 transition-[background-color,transform] duration-200 hover:-translate-y-1 hover:bg-surface-overlay hover:z-1";
// 深色稿 logo 需白底托，白色稿 logo 亮色下需墨底托，保证双主题对比度
const onLightChip = "logo-on-light box-border rounded-[0.4rem] bg-white/[0.94] px-[0.55rem] py-[0.3rem]";
const onDarkChip =
  "light:box-border light:rounded-[0.4rem] light:bg-ink light:px-[0.55rem] light:py-[0.3rem]";
---

<BaseLayout title="Teams" active="teams">
  <main id="main-content" class="shell pt-12 pb-section">
    <h1 class="title-page">Teams</h1>
    <SeasonFilter
      years={years}
      mode="link"
      baseHref="/teams"
      current={year}
      label="Filter by season"
      sticky
      client:load
    />
    <div class="grid grid-cols-1 gap-px rounded-md bg-line light:shadow-panel md:grid-cols-2 lg:grid-cols-3">
      {constructors.map((team) => (
        <a class={cardClasses} href={`/teams/${team.id}`}>
          <span class="card-logo-frame grid h-12 w-32 flex-none place-items-center">
            {logoSrcFor(vendorIndexes, team.id) ? (
              <img
                class:list={[
                  "card-logo block size-full min-w-0 min-h-0 object-contain",
                  logoVariantFor(vendorIndexes, team.id) !== "white"
                    ? onLightChip
                    : onDarkChip,
                ]}
                src={logoSrcFor(vendorIndexes, team.id)}
                alt=""
              />
            ) : (
              <span class="card-monogram grid size-12 place-items-center rounded-[10px] bg-line font-display text-[1.2rem] font-bold text-ink-strong" aria-hidden="true">
                {team.name.slice(0, 2).toUpperCase()}
              </span>
            )}
          </span>
          <span class="card-name text-center text-[0.9rem] font-semibold">{team.name}</span>
        </a>
      ))}
      {gridFillers(constructors.length).map((classes) => (
        <div class={`${classes} bg-surface`} aria-hidden="true" />
      ))}
    </div>
  </main>
</BaseLayout>
