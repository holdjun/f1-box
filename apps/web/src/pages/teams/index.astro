---
import { env } from "cloudflare:workers";

import BaseLayout from "../../layouts/BaseLayout.astro";
import SeasonFilter from "../../components/SeasonFilter.astro";
import {
  createD1TeamDatabase,
  createTeamRepository,
} from "../../lib/team-repository.js";
import {
  logoSrcFor,
  logoVariantFor,
  latestColor,
  vendorIndexes,
} from "../../lib/vendor.js";

const repository = import.meta.env.DEV
  ? createTeamRepository()
  : createTeamRepository(createD1TeamDatabase(env.F1_DB));

const years = await repository.getSeasonYears();
const yearParam = Astro.url.searchParams.get("year");
const year =
  yearParam !== null && years.includes(Number(yearParam))
    ? Number(yearParam)
    : null;
const constructors =
  year === null
    ? await repository.getConstructors()
    : await repository.getConstructorsByYear(year);

// 目录是全量聚合，边缘短暂缓存吸收重复请求
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=300, stale-while-revalidate=600",
);
---

<BaseLayout title="Teams" active="teams">
  <main id="main-content" class="page-shell">
    <h1>Teams</h1>
    <SeasonFilter
      years={years}
      mode="link"
      baseHref="/teams"
      current={year}
      label="Filter by season"
      sticky
    />
    <div class="team-grid">
      {constructors.map((team) => (
        <a
          class="team-card"
          href={`/teams/${team.id}`}
          style={`--team-color: ${latestColor(vendorIndexes, team.id) ?? "#84909e"}`}
        >
          <span class="card-logo-frame">
            {logoSrcFor(vendorIndexes, team.id) ? (
              <img
                class:list={[
                  "card-logo",
                  { "logo-on-light": logoVariantFor(vendorIndexes, team.id) !== "white" },
                ]}
                src={logoSrcFor(vendorIndexes, team.id)}
                alt=""
              />
            ) : (
              <span class="card-monogram" aria-hidden="true">
                {team.name.slice(0, 2).toUpperCase()}
              </span>
            )}
          </span>
          <span class="card-name">{team.name}</span>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  h1 {
    margin: 0 0 1.5rem;
  }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 1rem;
  }
  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--team-color) 22%, transparent),
        transparent 60%
      ),
      var(--ink-soft);
    color: var(--paper);
    text-decoration: none;
  }
  .team-card:hover {
    border-color: var(--team-color);
  }
  .card-logo-frame {
    display: grid;
    place-items: center;
    width: 8rem;
    height: 3rem;
    flex: none;
  }
  .card-logo {
    display: block;
    min-width: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .logo-on-light {
    box-sizing: border-box;
    padding: 0.3rem 0.55rem;
    border-radius: 0.4rem;
    background: rgba(255, 255, 255, 0.94);
  }
  .card-monogram {
    display: grid;
    place-items: center;
    height: 3rem;
    width: 3rem;
    border-radius: 10px;
    background: color-mix(in srgb, var(--team-color) 45%, transparent);
    font-family: var(--display);
    font-size: 1.2rem;
    font-weight: 700;
  }
  .card-name {
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
