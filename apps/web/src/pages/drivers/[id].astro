---
import { env } from "cloudflare:workers";

import BaseLayout from "../../layouts/BaseLayout.astro";
import CurrentSeasonPanel from "../../components/CurrentSeasonPanel.astro";
import HistoryEnd from "../../components/HistoryEnd.astro";
import SeasonMatrix from "../../components/SeasonMatrix.astro";
import {
  createD1DriverDatabase,
  createDriverRepository,
} from "../../lib/driver-repository.js";
import { formatUtcLongDate } from "../../lib/time.js";
import { monogram } from "../../lib/tokens.js";
import { resolveSeasonSelection } from "../../lib/routing.js";
import { colorForYear, latestColor, vendorIndexes } from "../../lib/vendor.js";

const slug = (Astro.params.id ?? "").toLowerCase();
const repository = import.meta.env.DEV
  ? createDriverRepository()
  : createDriverRepository(createD1DriverDatabase(env.F1_DB));

const driver = await repository.getDriver(slug);
if (!driver) Astro.response.status = 404;

// 上游数据最快 30 分钟更新一次，边缘短暂缓存可吸收重复请求
if (driver) {
  Astro.response.headers.set(
    "Cache-Control",
    "public, s-maxage=300, stale-while-revalidate=600",
  );
}

const currentYear = driver?.activeSeason ?? null;
const flagSrc = driver
  ? `/vendor/country-flags/${driver.alpha2Code.toLowerCase()}.svg`
  : null;
// 矩阵块按最后参赛轮次降序：teams[0] 是当前（或最后效力的）车队
const latestTeam = driver?.seasons[0]?.teams[0] ?? null;
const teamColor =
  (latestTeam && latestColor(vendorIndexes, latestTeam.id)) ?? "#84909e";
// hero 号码：与目录卡同口径，最后参赛号码优先（现役即当前号码），永久车号兜底
const driverNumber = driver
  ? (driver.lastNumber ?? driver.permanentNumber)
  : null;

// 多年多队拆成连续多表（每队一表，各自带队友），第二个起加转队连线；
// 已入季未出赛（如季初）的赛季没有车队，仍保留一块空表与将来轮次空列
const matrixSeasons = (driver?.seasons ?? []).flatMap((season) =>
  (season.teams.length > 0 ? season.teams : [null]).map((team, index) => ({
    year: season.year,
    metaText: team?.name ?? "",
    metaLinks: team
      ? [
          {
            name: team.name,
            href: `/teams/${team.id}`,
            color: colorForYear(vendorIndexes, team.id, season.year),
          },
        ]
      : [],
    split: index > 0,
    rounds: season.rounds,
    rows: [
      {
        name: driver?.name ?? "",
        href: null,
        flagCode: driver?.alpha2Code.toLowerCase() ?? null,
        highlight: false,
        results: team?.results ?? season.rounds.map(() => null),
      },
      ...(team?.teammates ?? []).map((teammate) => ({
        name: teammate.name,
        href: `/drivers/${teammate.id}`,
        flagCode: teammate.flagCode,
        highlight: false,
        muted: true,
        results: teammate.results,
      })),
    ],
    // 积分与夺冠标记只在首表显示，避免拆表重复
    points: index === 0 ? season.points : null,
    position: index === 0 ? season.position : null,
    championshipWon: index === 0 ? season.championshipWon : false,
    current: season.year === currentYear,
  })),
);

// ?year=1997,2007 只显示这些赛季（筛选状态可分享/后退）
const initialSelected = resolveSeasonSelection(
  Astro.url.searchParams.get("year"),
  new Set((driver?.seasons ?? []).map((s) => s.year)),
);

const stintLabel = "number-label mr-1.5 text-[0.68rem] uppercase tracking-[0.1em] text-ink-muted";
const stintYears = "number-years text-[0.68rem] text-ink-muted";
---

{driver ? (
  <BaseLayout
    title={driver.name}
    description={`${driver.fullName} — career statistics and complete race-by-race history.`}
    active="drivers"
  >
    <main id="main-content" class="shell pt-12 pb-section">
      <header class="flex flex-col gap-6 md:flex-row md:items-center" style={`--team-color: ${teamColor}`}>
        <span class="driver-number-frame grid h-16 w-24 flex-none place-items-center">
          {driverNumber !== null ? (
            /* 车号混入 --team-color（数据语义色）：深色下提亮、亮色下加深，两主题都可读 */
            <span class="driver-number font-display text-[3.2rem] leading-none font-bold italic tracking-[0.02em] [color:color-mix(in_srgb,var(--team-color)_45%,var(--ink))]">
              {driverNumber}
            </span>
          ) : (
            <span class="driver-monogram grid size-16 place-items-center rounded-[12px] bg-line font-display text-[1.6rem] font-bold text-ink-strong" aria-hidden="true">
              {monogram(driver.name)}
            </span>
          )}
        </span>
        <div>
          <h1 class="max-w-[12ch] text-display-lg uppercase">{driver.fullName}</h1>
          <p class="driver-country mt-3 flex items-center gap-1.5 text-[0.85rem] uppercase tracking-[0.06em] text-ink-strong">
            {flagSrc ? <img class="flag h-[0.95rem] w-auto" src={flagSrc} alt="" /> : null}
            {driver.countryName}
          </p>
          <p class="driver-bio mt-2 flex max-w-[46rem] flex-wrap items-center gap-x-2 gap-y-1 text-[0.95rem] leading-relaxed text-ink-strong">
            <span>Born {formatUtcLongDate(driver.dateOfBirth)}</span>
            <span aria-hidden="true">·</span>
            <span>{driver.placeOfBirth}</span>
            {driver.dateOfDeath ? (
              <>
                <span aria-hidden="true">·</span>
                <span>Died {formatUtcLongDate(driver.dateOfDeath)}</span>
              </>
            ) : null}
          </p>
        </div>
      </header>

      {driver.numberStints.length > 1 ? (
        <div class="mt-6 flex flex-wrap items-center gap-1.5 text-[0.78rem]" aria-label="Car number history">
          <span class={stintLabel}>Car number</span>
          {driver.numberStints.map((stint, index) => (
            <span class="number-item inline-flex items-center gap-1.5">
              {index > 0 ? <span class="number-arrow text-ink-muted">→</span> : null}
              <span class="number-chip inline-flex items-baseline gap-1.5 rounded-full border border-line px-2.5 py-0.5 text-ink-strong">
                #{stint.number}
                <span class={stintYears}>
                  {stint.yearFrom === stint.yearTo
                    ? stint.yearFrom
                    : `${stint.yearFrom}–${stint.yearTo}`}
                </span>
              </span>
            </span>
          ))}
        </div>
      ) : null}

      {driver.teamStints.length > 0 ? (
        <div class="mt-3 flex flex-wrap items-center gap-1.5 text-[0.78rem]" aria-label="Teams driven for">
          <span class={stintLabel}>Teams</span>
          {driver.teamStints.map((stint, index) => (
            <span class="number-item inline-flex items-center gap-1.5">
              {index > 0 ? <span class="number-arrow text-ink-muted">→</span> : null}
              <a
                class="team-chip inline-flex items-baseline gap-1.5 rounded-full border px-2.5 py-0.5 transition-colors hover:underline"
                href={`/teams/${stint.id}`}
                style={`--stint-color: ${colorForYear(vendorIndexes, stint.id, stint.yearTo) ?? "#84909e"}`}
              >
                {stint.name}
                <span class={stintYears}>
                  {stint.yearFrom === stint.yearTo
                    ? stint.yearFrom
                    : `${stint.yearFrom}–${stint.yearTo}`}
                </span>
              </a>
            </span>
          ))}
        </div>
      ) : null}

      <section class="info-panels">
        {driver.currentSeason && driver.currentSeason.year === currentYear ? (
          <CurrentSeasonPanel season={driver.currentSeason} />
        ) : null}
        <div class="info-panel" aria-label="Career stats">
          <h2>Career Stats</h2>
          <dl>
            <div><dt>Entries</dt><dd>{driver.totals.entries}</dd></div>
            <div><dt>Starts</dt><dd>{driver.totals.starts}</dd></div>
            <div><dt>Wins</dt><dd>{driver.totals.wins}</dd></div>
            <div><dt>Podiums</dt><dd>{driver.totals.podiums}</dd></div>
            <div><dt>Poles</dt><dd>{driver.totals.poles}</dd></div>
            <div><dt>Fastest laps</dt><dd>{driver.totals.fastestLaps}</dd></div>
            <div><dt>Points</dt><dd>{driver.totals.points}</dd></div>
            <div><dt>Sprint wins</dt><dd>{driver.totals.sprintWins}</dd></div>
            <div><dt>Championships</dt><dd>{driver.totals.championships}</dd></div>
            <div>
              <dt>Best position</dt>
              <dd>{driver.totals.bestChampionshipPosition ?? "—"}</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="mt-12" aria-labelledby="history-title">
        <h2 id="history-title" class="mb-2 text-2xl">Season results</h2>
        <SeasonMatrix
          seasons={matrixSeasons}
          rowLabel="Constructor"
          initialSelected={initialSelected}
        />
        <HistoryEnd
          summary={`${driver.seasons.at(-1)?.year ?? driver.activeSeason}–${driver.seasons[0]?.year ?? driver.activeSeason} · ${driver.seasons.length} ${driver.seasons.length === 1 ? "season" : "seasons"} of Grand Prix history`}
          backHref="/drivers"
          backLabel="Back to all drivers"
        />
      </section>
    </main>
  </BaseLayout>
) : (
  <BaseLayout title="Driver not found">
    <main id="main-content" class="shell pt-12 pb-section">
      <h1 class="title-page">Driver not found</h1>
      <p class="mt-4 text-ink-strong">No driver with this identifier exists in the database.</p>
    </main>
  </BaseLayout>
)}

<style>
  /* 车队 chip 用该 stint 结束年份的队色（--stint-color 行内下发，数据语义色例外） */
  a.team-chip {
    border-color: color-mix(in srgb, var(--stint-color) 45%, transparent);
    color: var(--stint-color);
  }
  /* 队色可能是白等浅色：亮色主题混入 ink 保住对比度 */
  :global([data-theme="light"]) a.team-chip {
    border-color: color-mix(in srgb, var(--stint-color) 45%, var(--line));
    color: color-mix(in srgb, var(--stint-color) 55%, var(--ink));
  }
</style>
