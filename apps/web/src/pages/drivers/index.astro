---
import SeasonFilter from "../../components/SeasonFilter.svelte";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { gridFillers } from "../../lib/layout.js";
import { resolveCatalogYear } from "../../lib/routing.js";
import { monogram } from "../../lib/tokens.js";

const { driver: driverRepository } = Astro.locals.app.repositories;
const years = await driverRepository.getSeasonYears();
const year = resolveCatalogYear(Astro.url.searchParams.get("year"), years);
const drivers =
  year === null
    ? await driverRepository.getDrivers()
    : await driverRepository.getDriversByYear(year);

const cardClasses =
  "driver-card group relative flex flex-col items-center gap-3 rounded-md bg-surface-raised p-5 transition-[background-color,transform] duration-200 [content-visibility:auto] [contain-intrinsic-size:auto_11rem] hover:-translate-y-1 hover:bg-surface-overlay hover:z-1";
---

<BaseLayout title="Drivers" active="drivers">
  <main id="main-content" class="shell pt-12 pb-section">
    <h1 class="title-page">Drivers</h1>
    <SeasonFilter
      years={years}
      mode="link"
      baseHref="/drivers"
      current={year}
      label="Filter by season"
      sticky
      client:load
    />
    <div class="grid grid-cols-1 gap-px rounded-md bg-line light:shadow-panel md:grid-cols-2 lg:grid-cols-3">
      {drivers.map((driver) => (
        <a class={cardClasses} href={`/drivers/${driver.id}`}>
          <span class="card-logo-frame grid h-12 w-32 flex-none place-items-center">
            {driver.number !== null ? (
              <span class="card-number font-display text-[2.8rem] leading-none font-bold italic tracking-[0.02em] text-ink-muted">
                {driver.number}
              </span>
            ) : (
              <span
                class="card-monogram grid size-12 place-items-center rounded-[10px] bg-line font-display text-[1.2rem] font-bold text-ink-strong"
                aria-hidden="true"
              >
                {monogram(driver.name)}
              </span>
            )}
          </span>
          <span class="card-name text-center text-base font-semibold">{driver.name}</span>
          <span class="card-meta flex items-center gap-1.5 text-[0.78rem] text-ink-muted">
            <span class="card-team">{driver.teamName ?? "—"}</span>
            {driver.flagCode ? (
              <img
                class="card-flag h-[0.8rem] w-auto rounded-[2px]"
                src={`/vendor/country-flags/${driver.flagCode}.svg`}
                alt=""
              />
            ) : null}
          </span>
        </a>
      ))}
      {gridFillers(drivers.length).map((classes) => (
        <div class={`${classes} bg-surface`} aria-hidden="true" />
      ))}
    </div>
  </main>
</BaseLayout>
