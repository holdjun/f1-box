---
import StatusPage from "../components/StatusPage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// 没有这一页时 Astro 的错误重路由会去匹配 /500，落进 [year] catch-all，
// 被当成垃圾年份 302 回首页——而首页同样查 D1，D1 一出问题整站就死循环重定向
Astro.response.status = 500;
Astro.response.headers.set("Cache-Control", "no-store");
---

<BaseLayout title="Red flag">
  <StatusPage
    code="500"
    title="Red flag"
    message="Something went wrong loading this data. Try again in a moment."
  />
</BaseLayout>
