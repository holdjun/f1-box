---
import ResultsNav from "../../../../components/ResultsNav.astro";
import SeasonFilter from "../../../../components/SeasonFilter.svelte";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { circuitTimeZone } from "../../../../lib/circuit-time.js";
import { formatRaceDate } from "../../../../lib/time.js";
import { monogramStyle as monogramStyleFor } from "../../../../lib/tokens.js";
import { colorForYear, logoSrcFor, logoVariantFor, vendorIndexes } from "../../../../lib/vendor.js";

const year = Number(Astro.params.year);
const { raceResults } = Astro.locals.app.repositories;
const [availableYears, races] = await Promise.all([
  raceResults.getSeasonYears(),
  raceResults.listRaces(year),
]);
if (!availableYears.includes(year)) Astro.response.status = 404;
// 空赛历显式 no-store，避免 data-sync 更新被边缘缓存延迟
if (races.length === 0) {
  Astro.response.headers.set("Cache-Control", "no-store");
}

// Winner monogram 底色用其当年车队配色，缺色不设变量，回落 components.css 的中性灰默认值
const winnerStyle = (teamId: string | null) =>
  monogramStyleFor(teamId ? colorForYear(vendorIndexes, teamId, year) : null);
---

<BaseLayout title={`${year} Race Results`} active="results" year={year}>
  <main id="main-content" class="shell pt-12 pb-section">
    <h1 class="title-page">{year} Race Results</h1>
    <ResultsNav year={year} active="races" />
    <SeasonFilter
      years={availableYears}
      mode="link"
      current={year}
      hrefPattern="/results/{year}/races"
      sticky
      showAll={false}
      client:load
    />
    <!-- biome-ignore lint/a11y/noNoninteractiveTabindex: 横滚表容器需要 tabindex，键盘用户才能滚动查看溢出列 -->
    <section class="table-scroll" aria-label={`${year} race results, scrollable`} tabindex="0">
      <table class="result-table" aria-label={`${year} race results`}>
        <thead>
          <tr>
            <th scope="col">Grand Prix</th>
            <th scope="col">Date</th>
            <th scope="col">Winner</th>
            <th scope="col">Team</th>
            <th scope="col">Laps</th>
            <th scope="col">Time</th>
          </tr>
        </thead>
        <tbody>
          {races.length === 0 ? (
            <tr><td class="empty-cell" colspan="6">No race results yet.</td></tr>
          ) : (
            races.map((race) => (
              <tr>
                <th scope="row">
                  <a class="vendor-cell" href={`/results/${year}/races/${race.slug}/race-result`}>
                    <img class="vendor-cell__flag" src={`/vendor/country-flags/${race.alpha2Code.toLowerCase()}.svg`} alt="" loading="lazy" />
                    {race.name}
                  </a>
                </th>
                <td>{formatRaceDate(race.date, race.time, circuitTimeZone(race.circuitId))}</td>
                <td>
                  {race.winnerDriverId && race.winnerName && race.winnerCode ? (
                    <a class="vendor-cell" href={`/drivers/${race.winnerDriverId}`} style={winnerStyle(race.winnerTeamId)}>
                      <span class="vendor-cell__monogram" aria-hidden="true">{race.winnerCode}</span>
                      <span class="vendor-cell__name">{race.winnerName}</span>
                    </a>
                  ) : "—"}
                </td>
                <td>
                  {race.winnerTeamId && race.winnerTeamName ? (
                    <a class="vendor-cell" href={`/teams/${race.winnerTeamId}`}>
                      {logoSrcFor(vendorIndexes, race.winnerTeamId) ? (
                        <img
                          class:list={[
                            "vendor-cell__logo",
                            logoVariantFor(vendorIndexes, race.winnerTeamId) === "white" && "vendor-cell__logo--chip",
                          ]}
                          src={logoSrcFor(vendorIndexes, race.winnerTeamId) ?? ""} alt="" loading="lazy"
                        />
                      ) : null}
                      {race.winnerTeamName}
                    </a>
                  ) : "—"}
                </td>
                <td>{race.laps}</td>
                <td>{race.winnerTime ?? "—"}</td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </section>
  </main>
</BaseLayout>
