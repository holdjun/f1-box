---
import RaceHeader from "../../../../../components/RaceHeader.astro";
import RaceTable from "../../../../../components/RaceTable.astro";
import RaceTabsNav from "../../../../../components/RaceTabsNav.astro";
import SeasonFilter from "../../../../../components/SeasonFilter.svelte";
import StatusPage from "../../../../../components/StatusPage.astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { RACE_TAB_FIELDS } from "../../../../../lib/race-results-repository.js";
import { RACE_TAB_LABELS, raceTabKeys, resolveRaceTab } from "../../../../../lib/routing.js";

const year = Number(Astro.params.year);
const slug = (Astro.params.slug ?? "").toLowerCase();
const tab = resolveRaceTab(Astro.params.tab ?? "");
const { raceResults } = Astro.locals.app.repositories;
const [availableYears, page] = await Promise.all([
  raceResults.getSeasonYears(),
  tab ? raceResults.getRacePage(year, slug) : Promise.resolve(null),
]);
// 数据异常（year 不在已知年份）时按 404 渲染，不缓存
const found = tab !== null && page !== null && availableYears.includes(year);
if (!found) Astro.response.status = 404;
// getRacePage 本就一次性取回所有 tab 的数据；全量渲染成面板后
// 客户端可就地切换，不再为每个 tab 走一次路由
const visibleTabs =
  tab && page
    ? raceTabKeys.filter((key) => page.tabs[RACE_TAB_FIELDS[key]].length > 0)
    : [];
---

{tab && page ? (
  <BaseLayout
    title={`${page.meta.name} ${RACE_TAB_LABELS[tab]}`}
    active="results"
    year={year}
  >
    <main id="main-content">
      <RaceHeader meta={page.meta} />
      <div class="shell pt-6 pb-section">
        <SeasonFilter
          years={availableYears}
          mode="link"
          current={year}
          hrefPattern={`/results/{year}/races/${slug}/${tab}`}
          sticky
          showAll={false}
          client:load
        />
        <RaceTabsNav year={year} slug={slug} active={tab} visibleTabs={visibleTabs} />
        {visibleTabs.map((key) => (
          <div data-race-tab-panel={key} hidden={key !== tab ? true : undefined}>
            <RaceTable tab={key} rows={page.tabs[RACE_TAB_FIELDS[key]]} year={year} />
          </div>
        ))}
      </div>
    </main>
  </BaseLayout>
) : (
  <BaseLayout title="Race not found" year={year}>
    <StatusPage code="404" title="Race not found" message="This race is not available yet." />
  </BaseLayout>
)}
