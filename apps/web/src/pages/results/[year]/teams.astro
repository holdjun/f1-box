---
import ResultsNav from "../../../components/ResultsNav.astro";
import SeasonFilter from "../../../components/SeasonFilter.svelte";
import StandingsTable from "../../../components/StandingsTable.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const year = Number(Astro.params.year);
const { raceResults } = Astro.locals.app.repositories;
const [availableYears, rows] = await Promise.all([
  raceResults.getSeasonYears(),
  raceResults.getConstructorStandings(year),
]);
if (!availableYears.includes(year)) Astro.response.status = 404;
// 空排名显式 no-store，避免 data-sync 更新被边缘缓存延迟
if (rows.length === 0) {
  Astro.response.headers.set("Cache-Control", "no-store");
}
---

<BaseLayout title={`${year} Constructor Standings`} active="results" year={year}>
  <main id="main-content" class="shell pt-12 pb-section">
    <h1 class="title-page">{year} Teams</h1>
    <ResultsNav year={year} active="teams" />
    <SeasonFilter
      years={availableYears}
      mode="link"
      current={year}
      hrefPattern="/results/{year}/teams"
      sticky
      showAll={false}
      client:load
    />
    <StandingsTable kind="constructors" rows={rows} year={year} />
  </main>
</BaseLayout>
