---
import type { SeasonPayload } from "@f1-box/contracts/season";

import FreshnessBadge from "../components/FreshnessBadge.astro";
import NextRaceHero from "../components/NextRaceHero.astro";
import SeasonRail from "../components/SeasonRail.astro";
import StandingsTable from "../components/StandingsTable.astro";
import StatusPage from "../components/StatusPage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSeason } from "../lib/page-data.js";

let season: SeasonPayload | undefined;
try {
  season = await getSeason(2026);
} catch (error) {
  console.error("season load failed", error);
  Astro.response.status = 503;
}

const nextRace = season?.events.find((event) => event.round === season?.nextRound);
const latestRound = season?.events.filter((event) => event.state === "complete").at(-1);
const podium = latestRound?.raceClassification?.rows.slice(0, 3) ?? [];
const source = season?.sources[0];
---

<BaseLayout
  title="2026 Season"
  active="racing"
  season={season?.season}
  sourceName={source?.name}
  fetchedAt={source?.fetchedAt}
  freshness={season?.freshness}
>
  {season && nextRace ? (
    <main id="main-content">
      <NextRaceHero event={nextRace} season={season.season} freshness={season.freshness} />

      <section class="calendar-section page-shell section-block" aria-labelledby="calendar-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker">{season.season} CALENDAR</p>
            <h2 id="calendar-title">Season track</h2>
          </div>
          <p class="section-count">{String(season.events.length).padStart(2, "0")} ROUNDS</p>
        </div>
        <SeasonRail events={season.events} season={season.season} />
      </section>

      <section class="latest-section section-band" aria-labelledby="latest-title">
        <div class="page-shell latest-section__inner">
          <div class="section-heading section-heading--light">
            <div>
              <p class="section-kicker">LATEST ROUND</p>
              <h2 id="latest-title">{latestRound?.raceName ?? "No completed rounds yet"}</h2>
            </div>
            {latestRound && (
              <a class="text-link" href={`/seasons/${season.season}/races/${latestRound.round}-${latestRound.slug}`}>
                Full result
              </a>
            )}
          </div>
          {latestRound ? (
            <div class="podium" aria-label={`${latestRound.raceName} podium`}>
              {podium.map((row, index) => (
                <article class={`podium__place podium__place--${index + 1}`}>
                  <p>{String(index + 1).padStart(2, "0")}</p>
                  <div>
                    <h3>{row.driverName}</h3>
                    <span>{row.constructorName}</span>
                  </div>
                  <strong>{row.points} PTS</strong>
                </article>
              ))}
            </div>
          ) : (
            <p class="empty-state">No completed rounds yet.</p>
          )}
        </div>
      </section>

      <section class="standings-preview page-shell section-block" aria-label="Standings previews">
        <article class="standings-panel">
          <div class="section-heading section-heading--compact">
            <div>
              <p class="section-kicker">DRIVER STANDINGS</p>
              <h2>Front runners</h2>
            </div>
            <a class="text-link" href="/seasons/2026#driver-standings">View full season</a>
          </div>
          <StandingsTable kind="drivers" rows={season.driverStandings} limit={5} />
        </article>
        <article class="standings-panel">
          <div class="section-heading section-heading--compact">
            <div>
              <p class="section-kicker">CONSTRUCTOR STANDINGS</p>
              <h2>Team order</h2>
            </div>
            <a class="text-link" href="/seasons/2026#constructor-standings">View full season</a>
          </div>
          <StandingsTable kind="constructors" rows={season.constructorStandings} limit={5} />
        </article>
      </section>

      <div class="source-strip page-shell">
        <FreshnessBadge freshness={season.freshness} />
        <p>Source: <span>{source?.name}</span></p>
      </div>
    </main>
  ) : (
    <StatusPage
      code="503"
      title="Season data unavailable"
      message="The latest 2026 season release could not be loaded. Please try again shortly."
    />
  )}
</BaseLayout>
