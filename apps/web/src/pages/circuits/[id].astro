---
import { env } from "cloudflare:workers";

import StatusPage from "../../components/StatusPage.astro";
import CircuitMap from "../../components/CircuitMap.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  createCircuitRepository,
  createD1CircuitDatabase,
} from "../../lib/circuit-repository.js";

const id = (Astro.params.id ?? "").toLowerCase();
const repository = import.meta.env.DEV
  ? createCircuitRepository()
  : createCircuitRepository(createD1CircuitDatabase(env.F1_DB));
const circuit = await repository.getCircuit(id);
if (!circuit) Astro.response.status = 404;
else {
  Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=600");
}
---

{circuit ? (
  <BaseLayout title={circuit.name} active="circuits">
    <main id="main-content" class="page-shell">
      <div class="circuit-hero">
        <div class="circuit-hero__map">
          {circuit.layoutId ? (
            <CircuitMap
              layoutId={circuit.layoutId}
              fallbackSrc={`/vendor/circuits/${circuit.layoutId}.svg`}
              alt={`${circuit.fullName} layout map`}
            />
          ) : (
            <p class="muted">No layout map available.</p>
          )}
        </div>
        <div class="circuit-hero__stats">
          <h1>{circuit.fullName}</h1>
          <p class="muted">
            {circuit.placeName}, {circuit.countryName} · {circuit.direction} · {circuit.turns} turns
          </p>
          <p class="circuit-hero__length">
            {circuit.length.toFixed(3)}<span>km</span>
          </p>
          <p class="circuit-hero__length-label">Circuit Length</p>
          <dl class="circuit-stats">
            <div>
              <dt>First Grand Prix</dt>
              <dd>{circuit.firstGrandPrix ?? "—"}</dd>
            </div>
            <div>
              <dt>Number of Laps</dt>
              <dd>{circuit.laps ?? "—"}</dd>
            </div>
            <div>
              <dt>Race Distance</dt>
              <dd>{circuit.distance === null ? "—" : `${circuit.distance.toFixed(3)}km`}</dd>
            </div>
            <div>
              <dt>Races Held</dt>
              <dd>{circuit.totalRacesHeld}</dd>
            </div>
            <div class="circuit-stats__wide">
              <dt>Fastest Lap</dt>
              <dd>
                {circuit.recordLap ? circuit.recordLap.time : "—"}
                {circuit.recordLap && (
                  <span class="muted">
                    {circuit.recordLap.driverName} ({circuit.recordLap.year})
                  </span>
                )}
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </main>
  </BaseLayout>
) : (
  <BaseLayout title="Circuit not found" active="circuits">
    <main id="main-content" class="page-shell">
      <StatusPage code="404" title="Circuit not found" message="This circuit is not available yet." />
    </main>
  </BaseLayout>
)}

<style>
  .circuit-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    padding-block: 2rem;
  }
  .circuit-hero__map :is(img, svg) {
    display: block;
    width: min(100%, 30rem);
    height: auto;
    margin-inline: auto;
  }
  .circuit-hero h1 {
    margin: 0;
    font-family: var(--display);
    text-transform: uppercase;
  }
  .circuit-hero__length {
    margin: 2rem 0 0;
    font-family: var(--display);
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
  }
  .circuit-hero__length span {
    margin-left: 0.25rem;
    font-size: 0.4em;
  }
  .circuit-hero__length-label {
    margin: 0.5rem 0 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
  }
  .circuit-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
    margin: 2rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .circuit-stats dt {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-light);
  }
  .circuit-stats dd {
    margin: 0.35rem 0 0;
    font-family: var(--display);
    font-size: 1.6rem;
    font-weight: 600;
  }
  .circuit-stats dd .muted {
    margin-left: 0.5rem;
    font-family: var(--body);
    font-size: 0.9rem;
  }
  .circuit-stats__wide {
    grid-column: 1 / -1;
  }
  @media (max-width: 800px) {
    .circuit-hero {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
