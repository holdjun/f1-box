---
import StatusPage from "../../components/StatusPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const { raceResults } = Astro.locals.app.repositories;
const id = (Astro.params.id ?? "").toLowerCase();
const latest = await raceResults.getLatestRaceByCircuit(id);
if (latest) {
  return Astro.redirect(
    `/results/${latest.year}/races/${latest.slug}/race-result`,
    301,
  );
}
Astro.response.status = 404;
---

<BaseLayout title="Circuit not found">
  <StatusPage code="404" title="Circuit not found" message="This circuit is not available yet." />
</BaseLayout>
