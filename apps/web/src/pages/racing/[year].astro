---
import RaceCard from "../../components/RaceCard.astro";
import RaceCountdown from "../../components/RaceCountdown.svelte";
import SeasonFilter from "../../components/SeasonFilter.svelte";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { circuitTimeZone } from "../../lib/circuit-time.js";
import type { RaceSummary } from "../../lib/race-results-repository.js";
import { formatLocalDateTime } from "../../lib/time.js";

const year = Number(Astro.params.year);
const { raceResults } = Astro.locals.app.repositories;
const [availableYears, races] = await Promise.all([
  raceResults.getSeasonYears(),
  raceResults.getSeasonCalendar(year),
]);
if (!availableYears.includes(year)) Astro.response.status = 404;
// 日历空时显式 no-store，避免 data-sync 更新被边缘缓存延迟
if (races.length === 0) {
  Astro.response.headers.set("Cache-Control", "no-store");
}

const completed = races.filter((race) => race.winnerName !== null);
const upcoming = races.filter((race) => race.winnerName === null);
// Next 取第一个还有未开始 session 的未完赛站（结果滞后发布时，面板仍指向
// 下一场即将开始的练习赛/排位/正赛所在站）；全部已过则回退首站
const now = Date.now();
const next =
  upcoming.find((race) =>
    race.sessions.some((s) => new Date(s.startsAtUtc).getTime() > now),
  ) ?? upcoming[0];
// 开赛时刻按赛道当地时区渲染（时区缩写自带在输出里，与卡片日期同口径）；
// 未公布时刻或无时区映射时回退 UTC，不把 UTC 冒充成当地时间
const nextZone =
  next?.time != null ? (circuitTimeZone(next.circuitId) ?? "UTC") : "UTC";
const nextLine = next
  ? `${formatLocalDateTime(`${next.date}T${next.time ?? "00:00"}:00Z`, nextZone)} · ${next.circuitPlace}`
  : null;
// 订阅/下载是纯链接无 JS 可用；复制 URL 由 client.ts 做剪贴板增强。
// origin 取当前请求域，预览环境订阅的是预览端点而非生产
const icsHref = `${Astro.url.origin}/api/calendar.ics?year=${year}`;
// 整体替换 scheme（含 https 的 s）：生产 https 下若只替换 http 前缀会产出非法的 webcals://
const webcalHref = icsHref.replace(/^https?:\/\//, "webcal://");
// 日历弹窗菜单项与 SeasonFilter 下拉选项同一 hover 语言
const calendarItemClass =
  "rounded px-3 py-2 text-left text-[0.82rem] text-ink-strong transition-colors hover:bg-surface-raised hover:text-ink";
// 荧光只给下一站：焦点唯一，避免整页色条噪音
const statusOf = (race: RaceSummary): "complete" | "next" | "upcoming" =>
  race.winnerName !== null ? "complete" : race === next ? "next" : "upcoming";
const cardHref = (race: RaceSummary) => `/results/${year}/races/${race.slug}/race-result`;
---

<BaseLayout title={`${year} Season`} year={year}>
  <section aria-label={`${year} season overview`} class="relative overflow-hidden border-b border-line">
    {/* 年份描边水印只填内容未占用的右侧空带：Next 卡会把字形遮掉大半只剩碎片，
        窄屏下字形又会压到眼眉与标题，两种情况都不渲染 */}
    {!next && (
      <p
        class="pointer-events-none absolute -top-4 right-0 hidden font-display text-[clamp(8rem,22vw,19rem)] leading-[0.8] font-bold text-transparent select-none lg:block [-webkit-text-stroke:1px_var(--line)]"
        aria-hidden="true"
      >{year}</p>
    )}
    <div class="shell relative grid gap-10 py-12 md:py-16 lg:grid-cols-[7fr_5fr] lg:items-end">
      <div>
        <p class="status-label">Formula 1 calendar</p>
        <h1 class="mt-3 text-display-lg uppercase">{year} Season</h1>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
          <p class="text-[0.85rem] text-ink-strong">
            {races.length} rounds · {completed.length} completed
          </p>
          <button
            type="button"
            class="button button--text calendar-entry-trigger"
            data-calendar-trigger
            hidden
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><rect x="3.5" y="5" width="17" height="15.5"
              /><path d="M3.5 9.5h17M8 3v4M16 3v4" /></svg
            >
            Add to calendar
          </button>
        </div>
        <p class="calendar-entry-fallback" data-calendar-fallback>
          <a class="underline decoration-line underline-offset-4" href={webcalHref}
            >Subscribe</a
          >
          <span aria-hidden="true"> · </span>
          <a
            class="underline decoration-line underline-offset-4"
            href={icsHref}
            download={`f1-${year}.ics`}>Download .ics</a
          >
          <span aria-hidden="true"> · </span>
          <code class="text-[0.72rem]" title={icsHref}>{icsHref}</code>
        </p>
        <dialog
          class="calendar-dialog"
          data-calendar-dialog
          aria-labelledby="calendar-dialog-title"
        >
          <div class="flex items-start justify-between gap-4">
            <h2
              id="calendar-dialog-title"
              class="font-display text-[1.25rem] leading-tight font-semibold uppercase"
            >
              Add F1 {year} to your calendar
            </h2>
            <button
              type="button"
              class="calendar-dialog__close"
              data-calendar-close
              aria-label="Close"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="M6 6l12 12M18 6L6 18" /></svg
              >
            </button>
          </div>
          <div class="mt-4 grid gap-0.5">
            <a class={calendarItemClass} href={webcalHref} data-calendar-subscribe
              >Subscribe — Apple Calendar</a
            >
            <a
              class={calendarItemClass}
              href={icsHref}
              download={`f1-${year}.ics`}
              data-calendar-download
            >Download .ics file</a>
            <div class="mt-1 min-w-0 border-t border-line pt-2">
              <button
                type="button"
                class:list={[calendarItemClass, "w-full cursor-pointer"]}
                data-calendar-copy={icsHref}
              >Copy calendar URL</button>
              <!-- Google/Outlook 网页版没有一键订阅深链，从网址添加是唯一可行路径 -->
              <p class="px-3 pt-1.5 text-[0.72rem] text-ink-muted">
                Google or Outlook: paste via "Add calendar → From URL"
              </p>
            </div>
          </div>
        </dialog>
      </div>
      {next && (
        <div class="relative isolate overflow-hidden rounded-md border border-line bg-surface-raised p-6 light:shadow-panel">
          {/* 赛道描边水印：与下方赛事卡同一手法，填住卡右侧的空带。
              isolate + -z-10 把它压在所有文字（含倒计时 island）之下，且仍在卡面背景之上 */}
          <img
            src={`/vendor/circuits/${next.circuitLayoutId}.svg`}
            alt=""
            loading="lazy"
            class="pointer-events-none absolute -right-6 -bottom-6 -z-10 h-32 w-auto opacity-15 light:invert md:-right-5 md:-bottom-7 md:h-40"
          />
          <p class="status-label status-label--accent">
            Next · Round {String(next.round).padStart(2, "0")}
          </p>
          <p class="mt-3 font-display text-[2rem] leading-[1.02] font-semibold uppercase">
            {next.name}
          </p>
          <RaceCountdown sessions={next.sessions} client:load />
          <p class="mt-2 flex items-center gap-2 text-[0.8rem] text-ink-strong">
            <img
              src={`/vendor/country-flags/${next.alpha2Code.toLowerCase()}.svg`}
              alt=""
              class="vendor-cell__flag rounded-[2px] border border-ink/25 object-cover"
            />
            {nextLine}
          </p>
          <div class="mt-5">
            <a class="button button--text" href={cardHref(next)}>View weekend</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <main id="main-content" class="shell pt-6 pb-section">
    <SeasonFilter
      years={availableYears}
      mode="link"
      current={year}
      hrefPattern="/racing/{year}"
      sticky
      showAll={false}
      client:load
    />

    {races.length === 0 ? (
      <div class="mt-10 rounded-md border border-line bg-surface-raised px-6 py-16 text-center light:shadow-panel">
        <p class="font-display text-[2rem] font-semibold uppercase">No rounds yet</p>
        <p class="mt-3 text-ink-muted">
          Race data for the {year} season has not been published yet. Check back soon.
        </p>
      </div>
    ) : (
      <>
        {completed.length > 0 && (
          <section aria-label="Completed races" class="mt-8">
            <div class="flex items-baseline gap-3">
              <h2 class="font-display text-[2rem] leading-none font-semibold uppercase">Completed</h2>
              <span class="font-display text-[1.3rem] text-ink-muted">{completed.length}</span>
            </div>
            {/* ≥1440px 时卡面宽度足够开三列（约 437px），两列下卡内中部大片空白；
                lg（980px）三列会把长国名挤换行，故单独取断点而不动全局 breakpoint */}
            <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2 min-[90rem]:grid-cols-3">
              {completed.map((race) => (
                <RaceCard race={race} href={cardHref(race)} status={statusOf(race)} />
              ))}
            </div>
          </section>
        )}
        {upcoming.length > 0 && (
          <section aria-label="Upcoming races" class="mt-12">
            <div class="flex items-baseline gap-3">
              <h2 class="font-display text-[2rem] leading-none font-semibold uppercase">Upcoming</h2>
              <span class="font-display text-[1.3rem] text-ink-muted">{upcoming.length}</span>
            </div>
            <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2 min-[90rem]:grid-cols-3">
              {upcoming.map((race) => (
                <RaceCard race={race} href={cardHref(race)} status={statusOf(race)} />
              ))}
            </div>
          </section>
        )}
      </>
    )}
  </main>
</BaseLayout>
