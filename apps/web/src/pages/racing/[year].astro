---
import RaceCard from "../../components/RaceCard.astro";
import RaceCountdown from "../../components/RaceCountdown.svelte";
import SeasonFilter from "../../components/SeasonFilter.svelte";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { RaceSummary } from "../../lib/race-results-repository.js";
import { formatUtcDateTime } from "../../lib/time.js";

const year = Number(Astro.params.year);
const { raceResults } = Astro.locals.app.repositories;
const [availableYears, races] = await Promise.all([
  raceResults.getSeasonYears(),
  raceResults.getSeasonCalendar(year),
]);
if (!availableYears.includes(year)) Astro.response.status = 404;
// 日历空时显式 no-store，避免 data-sync 更新被边缘缓存延迟
if (races.length === 0) {
  Astro.response.headers.set("Cache-Control", "no-store");
}

const completed = races.filter((race) => race.winnerName !== null);
const upcoming = races.filter((race) => race.winnerName === null);
// Next 取第一个还有未开始 session 的未完赛站（结果滞后发布时，面板仍指向
// 下一场即将开始的练习赛/排位/正赛所在站）；全部已过则回退首站
const now = Date.now();
const next =
  upcoming.find((race) =>
    race.sessions.some((s) => new Date(s.startsAtUtc).getTime() > now),
  ) ?? upcoming[0];
const nextLine = next
  ? `${formatUtcDateTime(`${next.date}T${next.time ?? "00:00"}:00Z`)} · ${next.circuitPlace}`
  : null;
// 荧光只给下一站：焦点唯一，避免整页色条噪音
const statusOf = (race: RaceSummary): "complete" | "next" | "upcoming" =>
  race.winnerName !== null ? "complete" : race === next ? "next" : "upcoming";
const cardHref = (race: RaceSummary) => `/results/${year}/races/${race.slug}/race-result`;
---

<BaseLayout title={`${year} Season`} year={year}>
  <section aria-label={`${year} season overview`} class="relative overflow-hidden border-b border-line">
    <p
      class="pointer-events-none absolute -top-4 right-0 font-display text-[clamp(8rem,22vw,19rem)] leading-[0.8] font-bold text-transparent select-none [-webkit-text-stroke:1px_var(--line)]"
      aria-hidden="true"
    >{year}</p>
    <div class="shell relative grid gap-10 py-12 md:py-16 lg:grid-cols-[7fr_5fr] lg:items-end">
      <div>
        <p class="status-label">Formula 1 calendar</p>
        <h1 class="mt-3 text-display-lg uppercase">{year} Season</h1>
        <p class="mt-4 text-[0.85rem] text-ink-strong">
          {races.length} rounds · {completed.length} completed
        </p>
      </div>
      {next && (
        <div class="relative overflow-hidden rounded-md border border-line bg-surface-raised p-6 light:shadow-panel">
          <p class="status-label status-label--accent">
            Next · Round {String(next.round).padStart(2, "0")}
          </p>
          <p class="mt-3 font-display text-[2rem] leading-[1.02] font-semibold uppercase">
            {next.name}
          </p>
          <RaceCountdown sessions={next.sessions} client:load />
          <p class="mt-2 flex items-center gap-2 text-[0.8rem] text-ink-strong">
            <img
              src={`/vendor/country-flags/${next.alpha2Code.toLowerCase()}.svg`}
              alt=""
              class="vendor-cell__flag"
            />
            {nextLine}
          </p>
          <a class="button button--text mt-5" href={cardHref(next)}>View weekend</a>
          <img
            src={`/vendor/circuits/${next.circuitLayoutId}.svg`}
            alt=""
            loading="lazy"
            class="pointer-events-none absolute top-1/2 right-5 h-20 w-24 -translate-y-1/2 object-contain opacity-15 light:invert"
          />
        </div>
      )}
    </div>
  </section>

  <main id="main-content" class="shell pt-10 pb-section">
    <SeasonFilter
      years={availableYears}
      mode="link"
      current={year}
      hrefPattern="/racing/{year}"
      sticky
      showAll={false}
      client:load
    />

    {races.length === 0 ? (
      <div class="mt-10 rounded-md border border-line bg-surface-raised px-6 py-16 text-center light:shadow-panel">
        <p class="font-display text-[2rem] font-semibold uppercase">No rounds yet</p>
        <p class="mt-3 text-ink-muted">
          Race data for the {year} season has not been published yet. Check back soon.
        </p>
      </div>
    ) : (
      <>
        {completed.length > 0 && (
          <section aria-label="Completed races" class="mt-10">
            <div class="flex items-baseline gap-3">
              <h2 class="font-display text-[2rem] leading-none font-semibold uppercase">Completed</h2>
              <span class="font-display text-[1.3rem] text-ink-muted">{completed.length}</span>
            </div>
            <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2">
              {completed.map((race) => (
                <RaceCard race={race} href={cardHref(race)} status={statusOf(race)} />
              ))}
            </div>
          </section>
        )}
        {upcoming.length > 0 && (
          <section aria-label="Upcoming races" class="mt-12">
            <div class="flex items-baseline gap-3">
              <h2 class="font-display text-[2rem] leading-none font-semibold uppercase">Upcoming</h2>
              <span class="font-display text-[1.3rem] text-ink-muted">{upcoming.length}</span>
            </div>
            <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2">
              {upcoming.map((race) => (
                <RaceCard race={race} href={cardHref(race)} status={statusOf(race)} />
              ))}
            </div>
          </section>
        )}
      </>
    )}
  </main>
</BaseLayout>
