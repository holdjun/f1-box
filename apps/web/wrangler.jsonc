{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-box",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "f1-box.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "F1_DB",
      "database_name": "f1db",
      "database_id": "50683ee9-c236-4bc5-bc11-4e8151916f54"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "785a3e7856964828a15458eefdb7ee7b"
    }
  ],
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
