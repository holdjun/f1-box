{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-box",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "r2_buckets": [
    {
      "binding": "F1_DATA",
      "bucket_name": "f1-box-data"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
