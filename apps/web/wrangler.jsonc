{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-box",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "f1-box.com", "custom_domain": true }
  ],
  "r2_buckets": [
    {
      "binding": "F1_DATA",
      "bucket_name": "f1-box-data"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "785a3e7856964828a15458eefdb7ee7b"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
