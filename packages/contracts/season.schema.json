{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f1-box.dev/schemas/season.schema.json",
  "title": "SeasonPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "freshness",
    "season",
    "currentRound",
    "nextRound",
    "events",
    "driverStandings",
    "constructorStandings",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "$ref": "#/$defs/utcTimestamp" },
    "freshness": { "enum": ["fresh", "stale", "delayed", "unavailable"] },
    "season": { "type": "integer" },
    "currentRound": { "type": ["integer", "null"], "minimum": 1 },
    "nextRound": { "type": ["integer", "null"], "minimum": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/seasonEvent" }
    },
    "driverStandings": {
      "type": "array",
      "items": { "$ref": "#/$defs/driverStanding" }
    },
    "constructorStandings": {
      "type": "array",
      "items": { "$ref": "#/$defs/constructorStanding" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "seasonEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "slug",
        "raceName",
        "startsAt",
        "state",
        "circuit",
        "sessions",
        "qualifyingClassification",
        "raceClassification"
      ],
      "properties": {
        "round": { "type": "integer", "minimum": 1 },
        "slug": { "type": "string" },
        "raceName": { "type": "string" },
        "startsAt": { "$ref": "#/$defs/utcTimestamp" },
        "state": {
          "enum": ["scheduled", "provisional", "complete", "delayed", "unavailable"]
        },
        "circuit": { "$ref": "#/$defs/circuit" },
        "sessions": {
          "type": "array",
          "items": { "$ref": "#/$defs/session" }
        },
        "qualifyingClassification": {
          "anyOf": [
            { "$ref": "#/$defs/qualifyingClassification" },
            { "type": "null" }
          ]
        },
        "raceClassification": {
          "anyOf": [
            { "$ref": "#/$defs/raceClassification" },
            { "type": "null" }
          ]
        }
      }
    },
    "circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "locality", "country", "latitude", "longitude"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "locality": { "type": "string" },
        "country": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "startsAt", "state"],
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string" },
        "startsAt": { "$ref": "#/$defs/utcTimestamp" },
        "state": {
          "enum": ["scheduled", "provisional", "complete", "delayed", "unavailable"]
        }
      }
    },
    "qualifyingClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionKey", "rows"],
      "properties": {
        "sessionKey": { "const": "qualifying" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualifyingRow" }
        }
      }
    },
    "qualifyingRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "driverCode",
        "driverName",
        "constructorName",
        "q1",
        "q2",
        "q3"
      ],
      "properties": {
        "position": { "type": "integer" },
        "driverCode": { "type": "string" },
        "driverName": { "type": "string" },
        "constructorName": { "type": "string" },
        "q1": { "type": ["string", "null"] },
        "q2": { "type": ["string", "null"] },
        "q3": { "type": ["string", "null"] }
      }
    },
    "raceClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionKey", "rows"],
      "properties": {
        "sessionKey": { "const": "race" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/raceRow" }
        }
      }
    },
    "raceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "driverCode",
        "driverName",
        "constructorName",
        "laps",
        "status",
        "points",
        "time",
        "fastestLap"
      ],
      "properties": {
        "position": { "type": "integer" },
        "driverCode": { "type": "string" },
        "driverName": { "type": "string" },
        "constructorName": { "type": "string" },
        "laps": { "type": "integer" },
        "status": { "type": "string" },
        "points": { "type": "number" },
        "time": { "type": ["string", "null"] },
        "fastestLap": { "type": ["string", "null"] },
        "fastestLapRank": { "type": ["integer", "null"] }
      }
    },
    "driverStanding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "name", "code", "points", "wins"],
      "properties": {
        "position": { "type": "integer" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "points": { "type": "number" },
        "wins": { "type": "integer" },
        "givenName": { "type": "string" },
        "familyName": { "type": "string" },
        "slug": { "type": "string" },
        "number": { "type": ["integer", "null"] },
        "nationality": { "type": "string" },
        "wikipediaUrl": { "type": "string" }
      }
    },
    "constructorStanding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "name", "points", "wins"],
      "properties": {
        "position": { "type": "integer" },
        "name": { "type": "string" },
        "points": { "type": "number" },
        "wins": { "type": "integer" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "fetchedAt"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "fetchedAt": { "$ref": "#/$defs/utcTimestamp" }
      }
    }
  }
}
