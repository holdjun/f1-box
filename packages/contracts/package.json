{
  "name": "@f1-box/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./fixtures/season-2026.json": "./fixtures/season-2026.json",
    "./season": "./src/season.ts",
    "./season.schema.json": "./season.schema.json",
    "./weekend": "./src/weekend.ts",
    "./weekend.schema.json": "./weekend.schema.json"
  },
  "scripts": {
    "generate": "json2ts --input weekend.schema.json --output src/weekend.generated.ts && json2ts --input season.schema.json --output src/season.generated.ts && node scripts/generate-validator.mjs",
    "check": "pnpm run generate && tsc --project tsconfig.json",
    "test": "pnpm run generate && vitest run"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
